# Copiar a deploy/.env y ajustar (nunca commitear .env)
POSTGRES_DB=hobbyxp
POSTGRES_USER=hobbyxp
POSTGRES_PASSWORD=cambiar-por-secreto-largo

HOBBYXP_USER=admin
HOBBYXP_PASSWORD=cambiar-por-contraseña-fuerte

# Dominio con DNS apuntando al VPS (Caddy emite HTTPS). Para prueba local: localhost
HOBBYXP_DOMAIN=hobbyxp.tudominio.com

BACKUP_KEEP_DAYS=14
