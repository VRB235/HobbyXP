<Window x:Class="HobbyXP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:HobbyXP.ViewModels.Navigation"
        xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
        Title="HobbyXP — Habit Tracking RPG"
        Height="900" Width="1360" MinHeight="680" MinWidth="1024"
        Background="{StaticResource MainBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <DockPanel Margin="8,16">
                <!-- Cabecera expandida -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16"
                      Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,44,0">
                        <TextBlock Text="HOBBY XP" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}" />
                        <TextBlock Text="Habit Tracking RPG" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource SidebarToggleButton}"
                            ToolTip="{Binding SidebarToggleTooltip}"
                            Command="{Binding ToggleSidebarCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Cabecera colapsada: marca vertical + avatar + nivel + toggle -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Style="{StaticResource SidebarToggleButton}"
                            ToolTip="{Binding SidebarToggleTooltip}"
                            Command="{Binding ToggleSidebarCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14" />

                    <Border Height="108" Margin="0,0,0,14" HorizontalAlignment="Center">
                        <TextBlock Text="HOBBY XP"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Opacity="0.95">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,6"
                          ToolTip="{Binding DisplayName}">
                        <Ellipse Fill="#2A3347"
                                 Stroke="{StaticResource AccentPurpleBrush}"
                                 StrokeThickness="2"
                                 Visibility="{Binding HasEquippedReward, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Ellipse Fill="#2A3347"
                                 Stroke="{StaticResource AccentGoldBrush}"
                                 StrokeThickness="2.5"
                                 Visibility="{Binding HasEquippedReward, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Ellipse Margin="3"
                                 Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="⚔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasCustomAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </Grid>

                    <TextBlock Text="{Binding SidebarLevelCompact}"
                               ToolTip="{Binding SidebarLevelText}"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGoldBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,4" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource DarkCard}" Margin="0,0,0,20" Padding="14"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="52" Height="52" Margin="0,0,12,0">
                                <Ellipse Fill="#2A3347"
                                         Stroke="{StaticResource AccentPurpleBrush}"
                                         StrokeThickness="2"
                                         Visibility="{Binding HasEquippedReward, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <Ellipse Fill="#2A3347"
                                         Stroke="{StaticResource AccentGoldBrush}"
                                         StrokeThickness="3"
                                         Visibility="{Binding HasEquippedReward, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Ellipse Margin="3"
                                         Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="⚔" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasCustomAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveDisplayNameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <controls:FormValidationBanner Message="{Binding DisplayNameValidationMessage}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SidebarLevelText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding HonorTitle}"
                                           Foreground="{StaticResource AccentGoldBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasHonorTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding EquippedRewardName}"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasEquippedReward, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding SidebarXpSummary}" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{Binding SidebarSpendableSummary}" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{Binding ImmunityText}"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasImmunity, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="📷 Avatar" Command="{Binding PickAvatarCommand}" Style="{StaticResource PrimaryButton}"
                                    Padding="8,4" FontSize="12" Margin="0,0,8,0" />
                            <Button Content="💾 Nombre" Command="{Binding SaveDisplayNameCommand}" Style="{StaticResource PrimaryButton}"
                                    Padding="8,4" FontSize="12" />
                        </StackPanel>

                        <controls:XpProgressBar Value="{Binding PlayerProgressPercentage}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type nav:NavigationItem}">
                            <Button Style="{StaticResource NavButton}"
                                    ToolTip="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Section}"
                                    DataContext="{Binding}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <Grid Width="28">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="16"
                                                   HorizontalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{StaticResource AccentGoldBrush}"
                                                CornerRadius="8" Padding="4,0" MinWidth="16"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#1A1208" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed,
                                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Column="1">
            <controls:GeometricBackground />
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#CC151B26" Padding="16,10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Historial XP"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,0"
                                MinHeight="30"
                                FontSize="12"
                                Margin="12,0,0,0"
                                ToolTip="Ver cantidad, motivo y fecha de cada XP ganado o gastado"
                                Command="{Binding OpenXpHistoryCommand}" />
                        <TextBlock Text="{Binding LatestAchievementMessage, FallbackValue='Bienvenido a tu aventura de hobbies.'}"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LatestAchievementMessage}" />
                    </DockPanel>
                </Border>

                <ContentControl Content="{Binding CurrentViewModel}" Margin="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Grid>

        <controls:LevelUpOverlay Grid.ColumnSpan="2" DataContext="{Binding}" Panel.ZIndex="1000" />
        <controls:MedalUnlockOverlay Grid.ColumnSpan="2" DataContext="{Binding}" Panel.ZIndex="1001" />
    </Grid>
</Window>
