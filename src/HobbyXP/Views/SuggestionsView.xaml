<UserControl x:Class="HobbyXP.Views.SuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             xmlns:helpers="clr-namespace:HobbyXP.Helpers"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <ScrollViewer x:Name="SuggestionsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="Sugerencias" Style="{StaticResource PageTitleText}" Margin="0,0,0,4" />
            <TextBlock Text="Registre mejoras y errores encontrados en la app. Puede adjuntar capturas y marcarlas como resueltas."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Style="{StaticResource DarkCard}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Nueva sugerencia" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SuggestionKindDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding ReportedDate}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Button Grid.Column="3" Content="Registrar" Command="{Binding RegisterCommand}"
                                Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                    </Grid>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Descripción" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Imágenes (opcional)" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Seleccionar imágenes" Command="{Binding PickPhotosCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="10,4" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SelectedPhotos}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedPhotos}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" Height="80" Margin="0,0,8,8" CornerRadius="8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BgInputBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Button Command="{Binding DataContext.OpenPhotoCommand, ElementName=SuggestionsScrollViewer}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Clic para ampliar"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0">
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                           Width="80" Height="80" />
                                                </Button>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemovePhotoCommand, ElementName=SuggestionsScrollViewer}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20" Padding="0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,2,0"
                                                        Background="#CC0D1117"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        BorderThickness="0" FontSize="10" Cursor="Hand"
                                                        Panel.ZIndex="1" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <GroupBox Header="Historial" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="320" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Buscar" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding KindFilterOptions}"
                                      SelectedItem="{Binding KindFilterOption}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Estado" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding StatusFilterOption}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="Desde:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                        <DatePicker Grid.Column="4" SelectedDate="{Binding FilterFromDate}"
                                    VerticalAlignment="Bottom" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="5" Text="Hasta:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                        <DatePicker Grid.Column="6" SelectedDate="{Binding FilterToDate}"
                                    VerticalAlignment="Bottom" Margin="0,0,12,0" />
                        <Button Grid.Column="7" Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Suggestions}"
                              MinHeight="320"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              helpers:GridViewStretchHelper.StretchColumns="True"
                              helpers:GridViewSortHelper.EnableSort="True"
                              MouseDoubleClick="OnSuggestionsMouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Título" Width="160"
                                                helpers:GridViewSortHelper.SortProperty="Title">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenSuggestionDetailCommand, ElementName=SuggestionsScrollViewer}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Ver detalle completo"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource AccentCyanBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding KindLabel}"
                                                helpers:GridViewSortHelper.SortProperty="Kind" Width="80" />
                                <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding StatusLabel}"
                                                helpers:GridViewSortHelper.SortProperty="Status" Width="90" />
                                <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding ReportedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                helpers:GridViewSortHelper.SortProperty="ReportedAt" Width="100" />
                                <GridViewColumn Header="Resuelta" DisplayMemberBinding="{Binding ResolvedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                helpers:GridViewSortHelper.SortProperty="ResolvedAt" Width="100" />
                                <GridViewColumn Header="Descripción" Width="220"
                                                helpers:GridViewSortHelper.SortProperty="Description">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenSuggestionDetailCommand, ElementName=SuggestionsScrollViewer}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Ver detalle completo"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left">
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Imágenes" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding PhotoPath, Converter={StaticResource PhotoPathsToImagesConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="40" Height="40" Margin="0,0,4,0" Padding="0"
                                                                Cursor="Hand"
                                                                ToolTip="Clic para ampliar / abrir"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Command="{Binding DataContext.OpenPhotoCommand, ElementName=SuggestionsScrollViewer}"
                                                                CommandParameter="{Binding}">
                                                            <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True">
                                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Status, Converter={StaticResource SuggestionResolveActionConverter}}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="8,2"
                                                    ToolTip="Cambiar estado resuelta / pendiente"
                                                    Command="{Binding DataContext.ToggleResolvedCommand, ElementName=SuggestionsScrollViewer}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    Style="{StaticResource DangerIconButton}"
                                                    ToolTip="Eliminar sugerencia"
                                                    Command="{Binding DataContext.DeleteSuggestionCommand, ElementName=SuggestionsScrollViewer}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AccentGreenBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
