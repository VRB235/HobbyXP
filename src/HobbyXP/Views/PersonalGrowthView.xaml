<UserControl x:Class="HobbyXP.Views.PersonalGrowthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Crecimiento Personal" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Libros">
                <ScrollViewer DataContext="{Binding Books}">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox Width="180" Text="{Binding Title}" Margin="0,0,8,0" />
                            <TextBox Width="160" Text="{Binding Author}" Margin="0,0,8,0" />
                            <TextBox Width="80" Text="{Binding TotalPages}" Margin="0,0,8,0" />
                            <Button Content="Agregar libro" Command="{Binding RegisterCommand}" Style="{StaticResource AccentButton}" />
                        </StackPanel>

                        <TextBlock Text="En lectura" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ReadingBooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8" Background="{StaticResource BgCardBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Author}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Height="16" Minimum="0"
                                                         Maximum="{Binding TotalPages, Converter={StaticResource MinIntConverter}}"
                                                         VerticalAlignment="Center" Margin="8,0">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource ProgressValueToMaxConverter}">
                                                        <Binding Path="PagesRead" />
                                                        <Binding Path="TotalPages" />
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>
                                            <TextBox Grid.Column="2" Text="{Binding PagesRead, UpdateSourceTrigger=PropertyLostFocus}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Actualizar" Margin="8,0,0,0" Padding="8,4"
                                                    Command="{Binding DataContext.UpdatePagesCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Terminados" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <ListView ItemsSource="{Binding CompletedBooks}" Height="160">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Título" DisplayMemberBinding="{Binding Title}" Width="220" />
                                    <GridViewColumn Header="Autor" DisplayMemberBinding="{Binding Author}" Width="160" />
                                    <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="60" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cursos">
                <StackPanel DataContext="{Binding Courses}" Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="220" Text="{Binding Name}" Margin="0,0,8,0" />
                        <TextBox Width="160" Text="{Binding Platform}" Margin="0,0,8,0" />
                        <Button Content="Registrar curso" Command="{Binding RegisterCommand}" Style="{StaticResource AccentButton}" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Courses}" Height="320">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Curso" DisplayMemberBinding="{Binding Name}" Width="240" />
                                <GridViewColumn Header="Plataforma" DisplayMemberBinding="{Binding Platform}" Width="140" />
                                <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                                <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
