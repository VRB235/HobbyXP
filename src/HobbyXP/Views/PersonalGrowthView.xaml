<UserControl x:Class="HobbyXP.Views.PersonalGrowthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Crecimiento Personal" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Stretch">
            <TabItem Header="Libros">
                <DockPanel x:Name="BooksPanel" DataContext="{Binding Books}" Margin="8">
                    <controls:HobbyXpBanner DockPanel.Dock="Top" DataContext="{Binding HobbyXp}" />
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Title}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Autor" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Author}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Páginas totales" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding TotalPages}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="3" Content="Agregar libro" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="80" Height="80" CornerRadius="6" ClipToBounds="True"
                                    Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Button Content="Imagen"
                                    Command="{Binding PickImageCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <Button Content="Quitar"
                                    Command="{Binding ClearImageCommand}"
                                    Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="En lectura" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ReadingRows}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Terminados" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding CompletedFromDate}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker Grid.Column="3" SelectedDate="{Binding CompletedToDate}" Margin="0,0,16,0" />
                            <Button Grid.Column="4" Content="Limpiar" Command="{Binding ClearCompletedDateFilterCommand}"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MinHeight="120">
                        <ItemsControl ItemsSource="{Binding CompletedBooks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:HistoryCoverCard Title="{Binding Title}"
                                                               Subtitle="{Binding Author}"
                                                               DateText="{Binding CompletedAtLabel}"
                                                               ImagePath="{Binding ImageDisplayPath}"
                                                               HasImage="{Binding HasImage}"
                                                               Item="{Binding}"
                                                               OpenCommand="{Binding DataContext.OpenDetailCommand, ElementName=BooksPanel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Cursos">
                <DockPanel x:Name="CoursesPanel" DataContext="{Binding Courses}" Margin="8">
                    <controls:HobbyXpBanner DockPanel.Dock="Top" DataContext="{Binding HobbyXp}" />
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Nombre del curso" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Name}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Plataforma" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Platform}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Sesiones totales" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding TotalSessions}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="3" Content="Agregar curso" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="80" Height="80" CornerRadius="6" ClipToBounds="True"
                                    Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Button Content="Imagen"
                                    Command="{Binding PickImageCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <Button Content="Quitar"
                                    Command="{Binding ClearImageCommand}"
                                    Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="En progreso" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding InProgressRows}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Terminados" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding CompletedFromDate}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker Grid.Column="3" SelectedDate="{Binding CompletedToDate}" Margin="0,0,16,0" />
                            <Button Grid.Column="4" Content="Limpiar" Command="{Binding ClearCompletedDateFilterCommand}"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MinHeight="120">
                        <ItemsControl ItemsSource="{Binding CompletedCourses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:HistoryCoverCard Title="{Binding Name}"
                                                               Subtitle="{Binding Platform}"
                                                               DateText="{Binding CompletedAtLabel}"
                                                               ImagePath="{Binding ImageDisplayPath}"
                                                               HasImage="{Binding HasImage}"
                                                               Item="{Binding}"
                                                               OpenCommand="{Binding DataContext.OpenDetailCommand, ElementName=CoursesPanel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
