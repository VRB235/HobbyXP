<UserControl x:Class="HobbyXP.Views.Controls.HobbyXpBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <Border Background="#1A2233"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Style="{StaticResource SubsectionTitleText}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LevelText}"
                       Foreground="{StaticResource AccentGoldBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <controls:XpProgressBar Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Value="{Binding ProgressPercentage}"
                                    Height="12"
                                    Margin="0,8,0,4" />

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding ProgressText}"
                       Style="{StaticResource MutedText}"
                       FontSize="12" />

            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Padding="8,6"
                    CornerRadius="6"
                    Background="#332018"
                    BorderBrush="#C45C3A"
                    BorderThickness="1"
                    Visibility="{Binding HasPenaltyReminder, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding PenaltyReminder}"
                           Foreground="#FFB39A"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</UserControl>
