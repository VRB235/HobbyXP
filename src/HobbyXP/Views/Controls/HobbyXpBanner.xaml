<UserControl x:Class="HobbyXP.Views.Controls.HobbyXpBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <Border Background="#1A2233"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Style="{StaticResource SubsectionTitleText}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LevelText}"
                       Foreground="{StaticResource AccentGoldBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <controls:XpProgressBar Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Value="{Binding ProgressPercentage}"
                                    Height="12"
                                    Margin="0,8,0,4" />

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding ProgressText}"
                       Style="{StaticResource MutedText}"
                       FontSize="12" />

            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Padding="8,6"
                    CornerRadius="6"
                    Background="#332018"
                    BorderBrush="#C45C3A"
                    BorderThickness="1"
                    Visibility="{Binding HasPenaltyReminder, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding PenaltyReminder}"
                           Foreground="#FFB39A"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasNextMedal, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding NextMedalText}"
                           Foreground="{StaticResource AccentGoldBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <controls:XpProgressBar Value="{Binding NextMedalPercent}"
                                        Height="8"
                                        Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Padding="8,6"
                    CornerRadius="6"
                    Background="#1A2A22"
                    BorderBrush="#3A7A5A"
                    BorderThickness="1"
                    Visibility="{Binding HasNearestReward, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56"
                            Height="56"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Background="#122018"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            ToolTip="Clic para ampliar la imagen del premio"
                            Visibility="{Binding HasNearestRewardImage, Converter={StaticResource BoolToVisibilityConverter}}"
                            MouseLeftButtonUp="OnNearestRewardImageClick">
                        <Image Source="{Binding NearestRewardImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                               Stretch="UniformToFill"
                               IsHitTestVisible="False" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding NearestRewardText}"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NearestRewardPriceLabel}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasNearestRewardPrice, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <controls:XpProgressBar Value="{Binding NearestRewardPercent}"
                                                Height="8"
                                                Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
