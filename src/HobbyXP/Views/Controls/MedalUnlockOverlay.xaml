<UserControl x:Class="HobbyXP.Views.Controls.MedalUnlockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsMedalUnlockVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <Grid Background="#CC05080F">
        <Border Width="520"
                Padding="28,24"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1A1624"
                BorderBrush="{StaticResource AccentGoldBrush}"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#FFD54F" Opacity="0.55" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="¡MEDALLA DESBLOQUEADA!"
                           Style="{StaticResource DisplayHeroText}"
                           FontSize="22"
                           Foreground="{StaticResource AccentGoldBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <Image Source="{Binding CelebrationMedalIconPath, Converter={StaticResource PathToImageSourceConverter}}"
                       Height="88" Margin="0,16,0,8" Stretch="Uniform"
                       Visibility="{Binding CelebrationMedalIconPath, Converter={StaticResource NullToVisibilityConverter}}" />

                <TextBlock Text="{Binding CelebrationMedalName}"
                           Style="{StaticResource DisplayHeroText}"
                           FontSize="28"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding CelebrationMedalDescription}"
                           Style="{StaticResource MutedText}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock Text="{Binding CelebrationMedalBonus, StringFormat=+{0:N0} XP canjeable}"
                           Foreground="{StaticResource AccentCyanBrush}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Ver logros"
                            Command="{Binding OpenAchievementsFromMedalCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,10"
                            Margin="0,0,10,0" />
                    <Button Content="Continuar"
                            Command="{Binding DismissMedalUnlockCommand}"
                            Style="{StaticResource AccentButton}"
                            Padding="18,10" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
