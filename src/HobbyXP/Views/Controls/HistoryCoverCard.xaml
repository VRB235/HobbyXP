<UserControl x:Class="HobbyXP.Views.Controls.HistoryCoverCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Width="168"
            Height="232"
            Margin="0,0,12,12"
            Background="#152033"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Button Command="{Binding OpenCommand, ElementName=Root}"
                    CommandParameter="{Binding Item, ElementName=Root}"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    ToolTip="Ver y editar">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <!-- Portada a pantalla completa -->
                    <Border Background="#1A2233">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Foreground="#B0B8C8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Image Source="{Binding ImagePath, ElementName=Root, Converter={StaticResource PathToImageSourceConverter}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Pie semitransparente sobre la imagen -->
                    <Border VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000D1117" Offset="0" />
                                <GradientStop Color="#990D1117" Offset="0.35" />
                                <GradientStop Color="#E60D1117" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="10,28,10,10">
                            <TextBlock Text="{Binding Title, ElementName=Root}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#F5F8FC"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"
                                       ToolTip="{Binding Title, ElementName=Root}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.85" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Meta: visible al hover para no tapar la portada en reposo -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="MaxHeight" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="MaxHeight" Value="48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                                           Foreground="#D7DEEA"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding DateText, ElementName=Root}"
                                           Foreground="#D7DEEA"
                                           FontSize="12"
                                           Margin="0,2,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>

            <Button Content="✕"
                    Width="28" Height="28"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Panel.ZIndex="1"
                    Style="{StaticResource DangerIconButton}"
                    ToolTip="Eliminar del historial"
                    Command="{Binding DeleteCommand, ElementName=Root}"
                    CommandParameter="{Binding Item, ElementName=Root}"
                    Visibility="{Binding DeleteCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
