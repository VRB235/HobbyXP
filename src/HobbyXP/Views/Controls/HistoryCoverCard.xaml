<UserControl x:Class="HobbyXP.Views.Controls.HistoryCoverCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Width="168"
            Margin="0,0,12,12"
            Background="#152033"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="110" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Grid.RowSpan="2"
                    Command="{Binding OpenCommand, ElementName=Root}"
                    CommandParameter="{Binding Item, ElementName=Root}"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    ToolTip="Ver y editar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="110" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#1A2233"
                            CornerRadius="10,10,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Image Source="{Binding ImagePath, ElementName=Root, Converter={StaticResource PathToImageSourceConverter}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                        <TextBlock Text="{Binding Title, ElementName=Root}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxHeight="40"
                                   ToolTip="{Binding Title, ElementName=Root}" />
                        <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DateText, ElementName=Root}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Row="0"
                    Content="✕"
                    Width="28" Height="28"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Panel.ZIndex="1"
                    Style="{StaticResource DangerIconButton}"
                    ToolTip="Eliminar del historial"
                    Command="{Binding DeleteCommand, ElementName=Root}"
                    CommandParameter="{Binding Item, ElementName=Root}"
                    Visibility="{Binding DeleteCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
