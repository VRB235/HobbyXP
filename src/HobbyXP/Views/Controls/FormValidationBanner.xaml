<UserControl x:Class="HobbyXP.Views.Controls.FormValidationBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{StaticResource DangerBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Visibility="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}" />
</UserControl>
