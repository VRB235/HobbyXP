<UserControl x:Class="HobbyXP.Views.Controls.ItemProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             Height="18">
    <UserControl.Resources>
        <conv:ProgressBarWidthConverter x:Key="ProgressBarWidthConverter" />
        <conv:ProgressValueClampConverter x:Key="ProgressValueClampConverter" />
    </UserControl.Resources>

    <Border Background="#2A3347"
            CornerRadius="8"
            ClipToBounds="True"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid x:Name="Track">
            <Border HorizontalAlignment="Left"
                    Background="{StaticResource XpProgressFillBrush}"
                    CornerRadius="8">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource ProgressBarWidthConverter}">
                        <Binding Path="Value"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Converter="{StaticResource ProgressValueClampConverter}" />
                        <Binding Source="0" />
                        <Binding Source="100" />
                        <Binding ElementName="Track" Path="ActualWidth" />
                    </MultiBinding>
                </Border.Width>
            </Border>

            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}%}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="White"
                       IsHitTestVisible="False">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4"
                                      ShadowDepth="0"
                                      Opacity="0.95"
                                      Color="#000000" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
