<UserControl x:Class="HobbyXP.Views.Controls.ItemProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             Height="22">
    <UserControl.Resources>
        <conv:ProgressBarWidthConverter x:Key="ProgressBarWidthConverter" />
        <conv:ProgressValueClampConverter x:Key="ProgressValueClampConverter" />
    </UserControl.Resources>

    <!-- Track con borde sutil; relleno con brillo y tipografía de display -->
    <Border Background="#141A26"
            BorderBrush="#2F3A50"
            BorderThickness="1"
            CornerRadius="11"
            ClipToBounds="True"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid x:Name="Track">
            <!-- Relleno -->
            <Border x:Name="Fill"
                    HorizontalAlignment="Left"
                    CornerRadius="10"
                    Margin="1">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource ProgressBarWidthConverter}">
                        <Binding Path="Value"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Converter="{StaticResource ProgressValueClampConverter}" />
                        <Binding Source="0" />
                        <Binding Source="100" />
                        <Binding ElementName="Track" Path="ActualWidth" />
                    </MultiBinding>
                </Border.Width>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6C3CE0" Offset="0" />
                        <GradientStop Color="#00A8E8" Offset="0.45" />
                        <GradientStop Color="#00E676" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="0"
                                      Opacity="0.55"
                                      Color="#00B0FF" />
                </Border.Effect>
                <Grid>
                    <!-- Sheen superior -->
                    <Border CornerRadius="10" Height="9" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#66FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}%}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#F5F8FC"
                       IsHitTestVisible="False">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5"
                                      ShadowDepth="0"
                                      Opacity="0.9"
                                      Color="#000000" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
