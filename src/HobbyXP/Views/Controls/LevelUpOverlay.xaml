<UserControl x:Class="HobbyXP.Views.Controls.LevelUpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsLevelUpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <UserControl.Resources>
        <Storyboard x:Key="CelebrateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowPulse" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.95" Duration="0:0:1.1" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Particle1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-28" Duration="0:0:1.4" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Particle2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-22" Duration="0:0:1.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Particle3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-30" Duration="0:0:1.6" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#CC05080F">
        <Border x:Name="GlowPulse" Width="420" Height="420" CornerRadius="210" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="2" Opacity="0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#00E676" Opacity="0.85" />
            </Border.Effect>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock Text="¡SUBISTE DE NIVEL!" Style="{StaticResource DisplayHeroText}" FontSize="28"
                       Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CelebrationLevel, StringFormat=NIVEL {0}}"
                       Style="{StaticResource DisplayHeroText}" FontSize="72" HorizontalAlignment="Center" Margin="0,8,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#7C4DFF" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding CelebrationTotalXp, StringFormat=XP total: {0:N0}}"
                       Foreground="{StaticResource AccentCyanBrush}" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                <Ellipse x:Name="Particle1" Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}" Margin="8">
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Particle2" Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}" Margin="8">
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Particle3" Width="12" Height="12" Fill="{StaticResource AccentGoldBrush}" Margin="8">
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
            </StackPanel>

            <Button Content="¡Continuar la aventura!" Command="{Binding DismissLevelUpCommand}"
                    Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Padding="24,12" FontSize="16" />
        </StackPanel>
    </Grid>
</UserControl>
