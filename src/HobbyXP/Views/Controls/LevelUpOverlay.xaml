<UserControl x:Class="HobbyXP.Views.Controls.LevelUpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsLevelUpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <UserControl.Resources>
        <Storyboard x:Key="GlowPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowPulse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.9" Duration="0:0:1.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GlowPulseOuter"
                             Storyboard.TargetProperty="Opacity"
                             From="0.12" To="0.45" Duration="0:0:1.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GlowPulse"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1.08" Duration="0:0:1.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GlowPulse"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1.08" Duration="0:0:1.2" AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="CelebrationPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.55" To="1.08" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.65" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CelebrationPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.55" To="1.08" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.65" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CelebrationPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="CelebrationPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             BeginTime="0:0:0.45" From="1.08" To="1" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="CelebrationPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             BeginTime="0:0:0.45" From="1.08" To="1" Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Key="SparkleStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SparkleLeft"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleRight"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleTop"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="-8" To="8" Duration="0:0:1.4" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot" Background="#CC05080F" ClipToBounds="False">
        <Canvas x:Name="ConfettiCanvas"
                IsHitTestVisible="False"
                ClipToBounds="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <Border x:Name="GlowPulseOuter"
                Width="520" Height="520"
                CornerRadius="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource AccentCyanBrush}"
                BorderThickness="1"
                Opacity="0.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="72" ShadowDepth="0" Color="#00E5FF" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <Border x:Name="GlowPulse"
                Width="420" Height="420"
                CornerRadius="210"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource AccentGreenBrush}"
                BorderThickness="2"
                Opacity="0.5"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#00E676" Opacity="0.85" />
            </Border.Effect>
        </Border>

        <StackPanel x:Name="CelebrationPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform />
            </StackPanel.RenderTransform>

            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="SparkleLeft"
                           Text="✦"
                           FontSize="28"
                           Foreground="{StaticResource AccentGoldBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="-36,0,0,0"
                           Opacity="0.4" />
                <TextBlock Text="¡SUBISTE DE NIVEL!"
                           Style="{StaticResource DisplayHeroText}"
                           FontSize="28"
                           Foreground="{StaticResource AccentGoldBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SparkleRight"
                           Text="✦"
                           FontSize="28"
                           Foreground="{StaticResource AccentCyanBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,-36,0"
                           Opacity="0.9" />
            </Grid>

            <TextBlock x:Name="SparkleTop"
                       Text="★"
                       FontSize="22"
                       Foreground="{StaticResource AccentGreenBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform />
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="{Binding CelebrationLevel, StringFormat=NIVEL {0}}"
                       Style="{StaticResource DisplayHeroText}"
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#7C4DFF" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="{Binding CelebrationTotalXp, StringFormat=XP total: {0:N0}}"
                       Foreground="{StaticResource AccentCyanBrush}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

            <Button Content="¡Continuar la aventura!"
                    Command="{Binding DismissLevelUpCommand}"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Center"
                    Padding="24,12"
                    FontSize="16" />
        </StackPanel>
    </Grid>
</UserControl>
