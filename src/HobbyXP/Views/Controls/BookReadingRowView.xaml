<UserControl x:Class="HobbyXP.Views.Controls.BookReadingRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <UserControl.Resources>
        <conv:FlexibleNumberConverter x:Key="FlexibleNumber" />
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Margin="0,0,0,8"
            Background="{StaticResource BgCardBrush}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Título" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Autor" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBox Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Guardar datos"
                        Style="{StaticResource PrimaryButton}"
                        Padding="10,4"
                        VerticalAlignment="Bottom"
                        Command="{Binding SaveMetadataCommand}"
                        ToolTip="Actualizar título y autor" />
            </Grid>

            <controls:FormValidationBanner Message="{Binding MetadataValidationMessage}" Margin="0,0,0,8" />

            <TextBlock Text="{Binding XpEarnedDisplay}"
                       Foreground="{StaticResource AccentGreenBrush}"
                       FontSize="12"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding ProgressSummary}"
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="0,0,0,6" />

            <controls:ItemProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                      Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding ReadingDate}"
                            Margin="0,0,8,0"
                            ToolTip="Fecha en que leyó (permite atrasar para disciplina semanal)" />

                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding TargetPercent, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        IsMoveToPointEnabled="True" />

                <controls:NumericStepper Grid.Column="2"
                                         Value="{Binding TargetPagesRead, Converter={StaticResource FlexibleNumber}}"
                                         Minimum="{Binding CurrentPagesRead}"
                                         Maximum="{Binding TotalPages}"
                                         Margin="0,0,8,0" />

                <Button Grid.Column="3"
                        Content="+10"
                        Style="{StaticResource PrimaryButton}"
                        Padding="8,4"
                        Margin="0,0,6,0"
                        Command="{Binding BumpPagesCommand}"
                        CommandParameter="10"
                        ToolTip="Sumar 10 páginas al objetivo" />

                <Button Grid.Column="4"
                        Content="Terminar"
                        Style="{StaticResource PrimaryButton}"
                        Padding="8,4"
                        Margin="0,0,6,0"
                        Command="{Binding SetCompleteCommand}"
                        ToolTip="Marcar todas las páginas como leídas" />

                <Button Grid.Column="5"
                        Content="Aplicar"
                        Style="{StaticResource AccentButton}"
                        Padding="10,4"
                        Command="{Binding ApplyPagesCommand}"
                        ToolTip="Guardar el progreso de lectura" />
            </Grid>

            <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
