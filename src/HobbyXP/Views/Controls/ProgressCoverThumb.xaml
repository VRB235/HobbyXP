<UserControl x:Class="HobbyXP.Views.Controls.ProgressCoverThumb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="88"
             Height="120">
    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="#1A2233"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Margin="0,0,12,0">
        <Grid>
            <TextBlock Text="Sin imagen"
                       Style="{StaticResource MutedText}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="6"
                       Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <Image Source="{Binding ImagePath, ElementName=Root, Converter={StaticResource PathToImageSourceConverter}}"
                   Stretch="UniformToFill"
                   Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel VerticalAlignment="Bottom"
                        Background="#CC0D1117"
                        Opacity="0.95">
                <Button Content="{Binding ImageActionLabel, ElementName=Root}"
                        Command="{Binding PickCommand, ElementName=Root}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="4,3"
                        FontSize="11"
                        Margin="4,4,4,2"
                        ToolTip="Seleccionar o cambiar portada" />
                <Button Content="Quitar"
                        Command="{Binding ClearCommand, ElementName=Root}"
                        Style="{StaticResource AccentButton}"
                        Padding="4,3"
                        FontSize="11"
                        Margin="4,0,4,4"
                        Visibility="{Binding HasImage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Quitar portada" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
