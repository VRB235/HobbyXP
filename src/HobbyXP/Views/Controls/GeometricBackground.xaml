<UserControl x:Class="HobbyXP.Views.Controls.GeometricBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid>
        <Rectangle Fill="{StaticResource GeometricPatternBrush}" Opacity="0.55" />
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#CC12151C" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
