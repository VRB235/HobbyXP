<UserControl x:Class="HobbyXP.Views.EntertainmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:FlexibleNumberConverter x:Key="FlexibleNumber" />
    </UserControl.Resources>
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Hobbies de Entretenimiento" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Stretch">
            <TabItem Header="Rompecabezas">
                <ScrollViewer x:Name="PuzzlesScrollViewer" DataContext="{Binding Puzzles}">
                    <StackPanel Margin="8">
                        <controls:HobbyXpBanner DataContext="{Binding HobbyXp}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Name}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Piezas" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding PieceCount}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Categoría" Style="{StaticResource MutedText}" />
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PuzzleCategoryDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                                <DatePicker SelectedDate="{Binding CompletedDate}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Registrar" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>
                        <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Fotos (opcional)" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Seleccionar fotos" Command="{Binding PickPhotosCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="10,4" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedPhotos}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedPhotos}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" Height="80" Margin="0,0,8,8" CornerRadius="8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BgInputBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Button Command="{Binding DataContext.OpenPhotoCommand, ElementName=PuzzlesScrollViewer}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Clic para ampliar"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0">
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                           Width="80" Height="80" />
                                                </Button>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemovePhotoCommand, ElementName=PuzzlesScrollViewer}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20" Padding="0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,2,0"
                                                        Background="#CC0D1117"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        BorderThickness="0" FontSize="10" Cursor="Hand"
                                                        Panel.ZIndex="1" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <GroupBox Header="Historial" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="280" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Buscar" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Categoría" Style="{StaticResource MutedText}" />
                                        <ComboBox ItemsSource="{Binding CategoryFilterOptions}"
                                                  SelectedItem="{Binding CategoryFilterOption}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Desde:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding FilterFromDate}"
                                                VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="Hasta:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                    <DatePicker Grid.Column="5" SelectedDate="{Binding FilterToDate}"
                                                VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                    <Button Grid.Column="6" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MinHeight="280">
                                    <ItemsControl ItemsSource="{Binding Puzzles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:HistoryCoverCard Title="{Binding Name}"
                                                                           Subtitle="{Binding CategoryLabel}"
                                                                           DateText="{Binding CompletedAtLabel}"
                                                                           ImagePath="{Binding ImageDisplayPath}"
                                                                           HasImage="{Binding HasImage}"
                                                                           Item="{Binding}"
                                                                           OpenCommand="{Binding DataContext.OpenDetailCommand, ElementName=PuzzlesScrollViewer}"
                                                                           DeleteCommand="{Binding DataContext.DeletePuzzleCommand, ElementName=PuzzlesScrollViewer}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Series y Películas">
                <DockPanel DataContext="{Binding Media}" Margin="8">
                    <controls:HobbyXpBanner DockPanel.Dock="Top" DataContext="{Binding HobbyXp}" />
                    <ScrollViewer x:Name="MediaScrollViewer" VerticalScrollBarVisibility="Auto">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Obra terminada" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Title}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                                <ComboBox ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding MediaType}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                                <DatePicker SelectedDate="{Binding CompletedDate}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="3" Content="Registrar" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="80" Height="80" CornerRadius="6" ClipToBounds="True"
                                    Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Button Content="Imagen"
                                    Command="{Binding PickImageCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <Button Content="Quitar"
                                    Command="{Binding ClearImageCommand}"
                                    Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Serie en progreso" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding SeriesTitle}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Capítulos totales" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding TotalChapters}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Agregar serie" Command="{Binding RegisterSeriesCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Border Width="80" Height="80" CornerRadius="6" ClipToBounds="True"
                                    Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Visibility="{Binding HasSeriesPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding SeriesPreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Button Content="Imagen"
                                    Command="{Binding PickSeriesImageCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <Button Content="Quitar"
                                    Command="{Binding ClearSeriesImageCommand}"
                                    Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSeriesPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="En visionado" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding InProgressSeriesRows}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding YearlyMovies, StringFormat=Películas ({0})}" Style="{StaticResource SubsectionTitleText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding YearlySeries, StringFormat=Series ({0})}" Style="{StaticResource SubsectionTitleText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding YearlyTotal, StringFormat=Total ({0})}" Style="{StaticResource SubsectionTitleText}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Historial" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />

                    <GroupBox Grid.Row="5" Header="Obras terminadas" Padding="12" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Buscar título" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                                    <ComboBox ItemsSource="{Binding MediaTypeFilterOptions}"
                                              SelectedItem="{Binding MediaTypeFilterOption}"
                                              DisplayMemberPath="Label" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Desde:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                <DatePicker Grid.Column="3" SelectedDate="{Binding FilterFromDate}"
                                            VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="4" Text="Hasta:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                <DatePicker Grid.Column="5" SelectedDate="{Binding FilterToDate}"
                                            VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                <Button Grid.Column="6" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MinHeight="160">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:HistoryCoverCard Title="{Binding Title}"
                                                                       Subtitle="{Binding MediaTypeLabel}"
                                                                       DateText="{Binding CompletedAtLabel}"
                                                                       ImagePath="{Binding ImageDisplayPath}"
                                                                       HasImage="{Binding HasImage}"
                                                                       Item="{Binding}"
                                                                       OpenCommand="{Binding DataContext.OpenDetailCommand, ElementName=MediaScrollViewer}"
                                                                       DeleteCommand="{Binding DataContext.DeleteEntryCommand, ElementName=MediaScrollViewer}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>
                </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Videojuegos">
                <ScrollViewer x:Name="VideoGamesScrollViewer" DataContext="{Binding VideoGames}">
                    <StackPanel Margin="8">
                        <controls:HobbyXpBanner DataContext="{Binding HobbyXp}" />
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding Title}" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Plataforma" Style="{StaticResource MutedText}" />
                                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Fecha inicio" Style="{StaticResource MutedText}" />
                                    <DatePicker SelectedDate="{Binding StartedDate}" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Progreso inicial (%)" Style="{StaticResource MutedText}" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding InitialCompletion}"
                                            VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="4" Content="Registrar" Command="{Binding RegisterCommand}"
                                        Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="80" Height="80" CornerRadius="6" ClipToBounds="True"
                                        Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Margin="0,0,8,0"
                                        Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <Button Content="Imagen"
                                        Command="{Binding PickImageCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <Button Content="Quitar"
                                        Command="{Binding ClearImageCommand}"
                                        Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                        </StackPanel>

                        <GroupBox Header="Historial" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Buscar título" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Plataforma" Style="{StaticResource MutedText}" />
                                        <ComboBox ItemsSource="{Binding PlatformFilterOptions}"
                                                  SelectedItem="{Binding PlatformFilterOption}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Desde:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding FilterFromDate}"
                                                VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="Hasta:" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                    <DatePicker Grid.Column="5" SelectedDate="{Binding FilterToDate}"
                                                VerticalAlignment="Bottom" Margin="0,0,12,0" />
                                    <Button Grid.Column="6" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                                </Grid>

                                <TextBlock Text="En progreso" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding InProgressRows}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8" Background="{StaticResource BgCardBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <controls:ProgressCoverThumb Grid.Column="0"
                                                                                 VerticalAlignment="Top"
                                                                                 ImagePath="{Binding Cover.ImageDisplayPath}"
                                                                                 HasImage="{Binding Cover.HasImage}"
                                                                                 ImageActionLabel="{Binding Cover.ImageActionLabel}"
                                                                                 PickCommand="{Binding Cover.PickCommand}"
                                                                                 ClearCommand="{Binding Cover.ClearCommand}" />

                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <StackPanel Margin="0,0,36,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding PlatformLabel}" />
                                                                <TextBlock Text="{Binding StartedAt, StringFormat=Inicio: {0:dd/MM/yyyy}}"
                                                                           Style="{StaticResource MutedText}" FontSize="12" />
                                                                <TextBlock Text="{Binding XpEarned, StringFormat='XP: {0}'}"
                                                                           Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Content="✕"
                                                                    Style="{StaticResource DangerIconButton}"
                                                                    ToolTip="Eliminar del historial"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.DeleteGameCommand, ElementName=VideoGamesScrollViewer}"
                                                                    CommandParameter="{Binding Game}" />
                                                        </Grid>

                                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                            <TextBlock Text="{Binding ProgressSummary}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       Margin="0,0,0,6" />
                                                            <controls:ItemProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                                      Margin="0,0,0,10" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <DatePicker Grid.Column="0"
                                                                            SelectedDate="{Binding ProgressDate}"
                                                                            Margin="0,0,8,0"
                                                                            ToolTip="Fecha del avance (permite atrasar para disciplina semanal)" />

                                                                <Slider Grid.Column="1"
                                                                        Minimum="{Binding CurrentCompletion}"
                                                                        Maximum="100"
                                                                        Value="{Binding TargetCompletion}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,0"
                                                                        TickFrequency="5"
                                                                        IsSnapToTickEnabled="False" />

                                                                <controls:NumericStepper Grid.Column="2"
                                                                                         Value="{Binding TargetCompletion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                                         Minimum="{Binding CurrentCompletion}"
                                                                                         Maximum="100"
                                                                                         Margin="0,0,8,0" />

                                                                <Button Grid.Column="3"
                                                                        Content="+10"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Padding="8,4"
                                                                        Margin="0,0,6,0"
                                                                        Command="{Binding BumpProgressCommand}"
                                                                        CommandParameter="10"
                                                                        ToolTip="Sumar 10% al objetivo" />

                                                                <Button Grid.Column="4"
                                                                        Content="100%"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Padding="8,4"
                                                                        Margin="0,0,6,0"
                                                                        Command="{Binding SetFullProgressCommand}"
                                                                        ToolTip="Marcar como completado al 100%" />

                                                                <Button Grid.Column="5"
                                                                        Content="Aplicar"
                                                                        Style="{StaticResource AccentButton}"
                                                                        Padding="10,4"
                                                                        Command="{Binding ApplyProgressCommand}"
                                                                        ToolTip="Guardar el nuevo progreso" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Juegos platinados" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MinHeight="160">
                                    <ItemsControl ItemsSource="{Binding PlatinumGames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:HistoryCoverCard Title="{Binding Title}"
                                                                           Subtitle="{Binding PlatformLabel}"
                                                                           DateText="{Binding HistoryDateLabel}"
                                                                           ImagePath="{Binding ImageDisplayPath}"
                                                                           HasImage="{Binding HasImage}"
                                                                           Item="{Binding}"
                                                                           OpenCommand="{Binding DataContext.OpenDetailCommand, ElementName=VideoGamesScrollViewer}"
                                                                           DeleteCommand="{Binding DataContext.DeleteGameCommand, ElementName=VideoGamesScrollViewer}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
