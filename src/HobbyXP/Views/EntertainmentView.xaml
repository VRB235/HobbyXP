<UserControl x:Class="HobbyXP.Views.EntertainmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             xmlns:helpers="clr-namespace:HobbyXP.Helpers"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:FlexibleNumberConverter x:Key="FlexibleNumber" />
    </UserControl.Resources>
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Hobbies de Entretenimiento" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Stretch">
            <TabItem Header="Rompecabezas">
                <ScrollViewer x:Name="PuzzlesScrollViewer" DataContext="{Binding Puzzles}">
                    <StackPanel Margin="8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Name}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Piezas" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding PieceCount}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Categoría" Style="{StaticResource MutedText}" />
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PuzzleCategoryDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                                <DatePicker SelectedDate="{Binding CompletedDate}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Registrar" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Fotos (opcional)" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Seleccionar fotos" Command="{Binding PickPhotosCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="10,4" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SelectedPhotos}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedPhotos}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" Height="80" Margin="0,0,8,8" CornerRadius="8"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BgInputBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemovePhotoCommand, ElementName=PuzzlesScrollViewer}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20" Padding="0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,2,2,0"
                                                        Background="#CC0D1117"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        BorderThickness="0" FontSize="10" Cursor="Hand" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <GroupBox Header="Historial" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding FilterToDate}" Margin="0,0,16,0" />
                                    <Button Grid.Column="4" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Puzzles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="200" Margin="4" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource BgCardBrush}">
                                                <Grid>
                                                    <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding PhotoPath, Converter={StaticResource PhotoPathsToImagesConverter}}"
                                                                  Margin="0,0,0,8">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="56" Height="56" Margin="0,0,6,6" CornerRadius="6"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        ClipToBounds="True">
                                                                    <Image Source="{Binding}" Stretch="UniformToFill" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PieceCount, StringFormat={}{0} piezas}" />
                                                    <TextBlock Text="{Binding Category, Converter={StaticResource PuzzleCategoryDisplayConverter}}" />
                                                    <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding XpEarned, StringFormat=+{0} XP}"
                                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button Content="✕"
                                                            Style="{StaticResource DangerIconButton}"
                                                            ToolTip="Eliminar del historial"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.DeletePuzzleCommand, ElementName=PuzzlesScrollViewer}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Series y Películas">
                <Grid DataContext="{Binding Media}" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding Title}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding MediaType}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding CompletedDate}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Button Grid.Column="3" Content="Registrar" Command="{Binding RegisterCommand}"
                                Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding YearlyMovies, StringFormat=Películas ({0})}" Margin="0,0,16,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding YearlySeries, StringFormat=Series ({0})}" Margin="0,0,16,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding YearlyTotal, StringFormat=Total ({0})}" FontWeight="SemiBold" />
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="Historial" Padding="12" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <DatePicker Grid.Column="3" SelectedDate="{Binding FilterToDate}" Margin="0,0,16,0" />
                                <Button Grid.Column="4" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                            </Grid>

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding History}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      helpers:GridViewStretchHelper.StretchColumns="True">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Título" DisplayMemberBinding="{Binding Title}" Width="220" />
                                        <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding MediaType}" Width="90" />
                                        <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="100" />
                                        <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="60" />
                                        <GridViewColumn Header="" Width="44">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕"
                                                            Style="{StaticResource DangerIconButton}"
                                                            ToolTip="Eliminar del historial"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Videojuegos">
                <ScrollViewer DataContext="{Binding VideoGames}">
                    <StackPanel Margin="8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Title}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Plataforma" Style="{StaticResource MutedText}" />
                                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Fecha inicio" Style="{StaticResource MutedText}" />
                                <DatePicker SelectedDate="{Binding StartedDate}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Progreso inicial (%)" Style="{StaticResource MutedText}" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding InitialCompletion}"
                                        VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Registrar" Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" />
                        </Grid>

                        <GroupBox Header="Historial" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding FilterToDate}" Margin="0,0,16,0" />
                                    <Button Grid.Column="4" Content="Limpiar" Command="{Binding ClearDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="En progreso" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding InProgressRows}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8" Background="{StaticResource BgCardBrush}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <StackPanel Margin="0,0,36,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Platform}" />
                                                            <TextBlock Text="{Binding StartedAt, StringFormat=Inicio: {0:dd/MM/yyyy}}"
                                                                       Style="{StaticResource MutedText}" FontSize="12" />
                                                            <TextBlock Text="{Binding XpEarned, StringFormat='XP: {0}'}"
                                                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Button Content="✕"
                                                                Style="{StaticResource DangerIconButton}"
                                                                ToolTip="Eliminar del historial"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding Game}" />
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding ProgressSummary}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,6" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Slider Grid.Column="0"
                                                                    Minimum="{Binding CurrentCompletion}"
                                                                    Maximum="100"
                                                                    Value="{Binding TargetCompletion}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0"
                                                                    TickFrequency="5"
                                                                    IsSnapToTickEnabled="False" />

                                                            <controls:NumericStepper Grid.Column="1"
                                                                                     Value="{Binding TargetCompletion, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                                     Minimum="{Binding CurrentCompletion}"
                                                                                     Maximum="100"
                                                                                     Margin="0,0,8,0" />

                                                            <Button Grid.Column="2"
                                                                    Content="+10"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding BumpProgressCommand}"
                                                                    CommandParameter="10"
                                                                    ToolTip="Sumar 10% al objetivo" />

                                                            <Button Grid.Column="3"
                                                                    Content="100%"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding SetFullProgressCommand}"
                                                                    ToolTip="Marcar como completado al 100%" />

                                                            <Button Grid.Column="4"
                                                                    Content="Aplicar"
                                                                    Style="{StaticResource AccentButton}"
                                                                    Padding="10,4"
                                                                    Command="{Binding ApplyProgressCommand}"
                                                                    ToolTip="Guardar el nuevo progreso" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Juegos platinados" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PlatinumGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="2" CornerRadius="10" Padding="12" Margin="0,0,0,8" Background="#2A2418">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Platform}" />
                                                        <TextBlock Text="{Binding PlatinumUnlockedAt, StringFormat=Platino: {0:dd/MM/yyyy}}" />
                                                        <TextBlock Text="{Binding XpEarned, StringFormat=+{0} XP}"
                                                                   Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button Content="✕"
                                                            Style="{StaticResource DangerIconButton}"
                                                            ToolTip="Eliminar del historial"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
