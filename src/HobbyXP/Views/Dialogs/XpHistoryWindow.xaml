<Window x:Class="HobbyXP.Views.Dialogs.XpHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HobbyXP.Helpers"
        Title="Historial de XP"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="920"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Command="{Binding CloseCommand}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Historial de XP"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Cantidad, motivo y fecha de cada movimiento del libro mayor."
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Actualizar"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,0"
                        MinHeight="32"
                        Margin="10,0,0,0"
                        Command="{Binding RefreshCommand}" />
                <CheckBox DockPanel.Dock="Right"
                          Content="Solo ganancias"
                          IsChecked="{Binding CreditsOnly}"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="10,0,0,0" />
                <ComboBox DockPanel.Dock="Right"
                          Width="180"
                          MinHeight="32"
                          Margin="10,0,0,0"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding ModuleFilterOptions}"
                          SelectedItem="{Binding ModuleFilterOption}"
                          DisplayMemberPath="Label"
                          ToolTip="Filtrar por módulo (hobby o global)" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="32"
                         VerticalContentAlignment="Center"
                         ToolTip="Filtrar por descripción, tipo o módulo" />
            </DockPanel>

            <ListView Grid.Row="2"
                      ItemsSource="{Binding Entries}"
                      helpers:GridViewStretchHelper.StretchColumns="True"
                      helpers:GridViewSortHelper.EnableSort="True"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Background="#121822">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Fecha"
                                        Width="140"
                                        helpers:GridViewSortHelper.SortProperty="EarnedAtLocal"
                                        DisplayMemberBinding="{Binding EarnedAtLabel}" />
                        <GridViewColumn Header="XP"
                                        Width="90"
                                        helpers:GridViewSortHelper.SortProperty="Amount">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountLabel}"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource Font.Display}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDebit}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Motivo"
                                        Width="280"
                                        helpers:GridViewSortHelper.SortProperty="Description">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tipo"
                                        Width="180"
                                        helpers:GridViewSortHelper.SortProperty="ActionLabel"
                                        DisplayMemberBinding="{Binding ActionLabel}" />
                        <GridViewColumn Header="Módulo"
                                        Width="140"
                                        helpers:GridViewSortHelper.SortProperty="HobbyLabel"
                                        DisplayMemberBinding="{Binding HobbyLabel}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Cerrar"
                        Style="{StaticResource AccentButton}"
                        Padding="18,0"
                        MinHeight="34"
                        Command="{Binding CloseCommand}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
