<Window x:Class="HobbyXP.Views.Dialogs.OfficialRaceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
        Title="Detalle de carrera oficial"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="560"
        Height="640"
        MinWidth="420"
        MinHeight="480"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,12,8">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Click="OnCloseClick" />
                <TextBlock Text="Detalle de carrera oficial"
                           Style="{StaticResource SectionTitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="16,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Width="220"
                            Height="140"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#1A2233"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Seleccionar imagen"
                                Command="{Binding PickImageCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Quitar imagen"
                                Command="{Binding ClearImageCommand}"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>

                    <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Distancia (km)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding DistanceKm, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fecha del evento" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding EventDate}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ubicación" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,12" />

                    <CheckBox Content="Carrera completada"
                              IsChecked="{Binding IsCompleted}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Descripción" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="72"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,12" />

                    <StackPanel Visibility="{Binding PreparationStats, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Estadísticas de preparación"
                                   Style="{StaticResource SubsectionTitleText}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PreparationStats.TrainingSessionCount, StringFormat=Entrenamientos: {0}}" />
                        <TextBlock Text="{Binding PreparationStats.TotalTrainingKm, StringFormat=Km totales: {0:0.##}}" />
                        <TextBlock Text="{Binding PreparationStats.BestPaceMinPerKm, StringFormat=Mejor ritmo: {0:0.00} min/km}" />
                    </StackPanel>

                    <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,12,16,16">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
