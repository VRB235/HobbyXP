<Window x:Class="HobbyXP.Views.Dialogs.ConfirmationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="460"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource DangerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Background="#3A1E1E"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="!"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource SectionTitleText}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               LineHeight="20" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <Button Content="No"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="OnNoClick" />
                <Button Content="Sí"
                        Style="{StaticResource DangerButton}"
                        MinWidth="96"
                        IsDefault="True"
                        Click="OnYesClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
