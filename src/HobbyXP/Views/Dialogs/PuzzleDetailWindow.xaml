<Window x:Class="HobbyXP.Views.Dialogs.PuzzleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
        Title="Detalle de rompecabezas"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="560"
        Height="640"
        MinWidth="420"
        MinHeight="480"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,12,8">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Click="OnCloseClick" />
                <TextBlock Text="Detalle de rompecabezas"
                           Style="{StaticResource SectionTitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="16,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Fotos"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="Seleccionar fotos"
                                Command="{Binding PickPhotosCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,4" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Photos}"
                                  Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80" Height="80" Margin="0,0,8,8" CornerRadius="8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="{StaticResource BgInputBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Preview}"
                                               Stretch="UniformToFill"
                                               Width="80" Height="80" />
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="20" Height="20" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,2,2,0"
                                                Background="#CC0D1117"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                BorderThickness="0" FontSize="10" Cursor="Hand"
                                                Panel.ZIndex="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Piezas" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding PieceCount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Categoría" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding Category}"
                                      Margin="0,2,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PuzzleCategoryDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Fecha de finalización" Style="{StaticResource MutedText}" />
                    <DatePicker SelectedDate="{Binding CompletedDate}"
                                Margin="0,2,0,12" />

                    <TextBlock Text="XP ganado" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding XpEarned}"
                               Margin="0,2,0,12" />

                    <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,12,16,16">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
