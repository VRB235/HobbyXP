<Window x:Class="HobbyXP.Views.Dialogs.RewardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
        Title="Detalle del premio"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="560"
        Height="680"
        MinWidth="420"
        MinHeight="520"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,12,8">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Click="OnCloseClick" />
                <TextBlock Text="{Binding WindowTitle}"
                           Style="{StaticResource SectionTitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="16,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Width="220"
                            Height="140"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#1A2233"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Button Command="{Binding OpenPhotoCommand}"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    ToolTip="Clic para ampliar"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                       Stretch="UniformToFill"
                                       Width="220"
                                       Height="140" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Seleccionar imagen"
                                Command="{Binding PickImageCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Quitar imagen"
                                Command="{Binding ClearImageCommand}"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>

                    <TextBlock Text="Módulo" Style="{StaticResource MutedText}" />
                    <ComboBox ItemsSource="{Binding ModuleOptions}"
                              SelectedItem="{Binding SelectedModule}"
                              DisplayMemberPath="Label"
                              Margin="0,2,0,12" />

                    <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Costo base (XP)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding CostInPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Precio ($)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Descripción (opcional)" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="56"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,12" />

                    <TextBlock Text="Link de compra" Style="{StaticResource MutedText}" />
                    <Grid Margin="0,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding PurchaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Content="Abrir link"
                                Command="{Binding OpenPurchaseUrlCommand}"
                                Style="{StaticResource AccentButton}" />
                    </Grid>

                    <TextBlock Text="{Binding RedeemHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding RedeemHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding IsRedeemed, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Margin="16,12,16,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Eliminar"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            MinWidth="96"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsCreateMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Content="Canjear"
                            Command="{Binding RedeemCommand}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="96"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsCreateMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsRedeemed, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Equipar reliquia"
                            Command="{Binding EquipCommand}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="120"
                            Margin="0,0,10,0" />
                    <Button Content="Desequipar"
                            Command="{Binding UnequipCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="120" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="96"
                            Margin="0,0,10,0"
                            IsCancel="True" />
                    <Button Content="{Binding SaveButtonLabel}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="96"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
