<Window x:Class="HobbyXP.Views.Dialogs.VideoGameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
        Title="Detalle de videojuego"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="560"
        Height="640"
        MinWidth="420"
        MinHeight="480"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,12,8">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Click="OnCloseClick" />
                <TextBlock Text="Detalle de videojuego"
                           Style="{StaticResource SectionTitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="16,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Width="220"
                            Height="140"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Background="#1A2233"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Seleccionar imagen"
                                Command="{Binding PickImageCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Quitar imagen"
                                Command="{Binding ClearImageCommand}"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>

                    <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,12" />

                    <TextBlock Text="Plataforma" Style="{StaticResource MutedText}" />
                    <ComboBox ItemsSource="{Binding Platforms}"
                              SelectedItem="{Binding Platform}"
                              Margin="0,2,0,12" />

                    <TextBlock Text="Fecha de inicio" Style="{StaticResource MutedText}" />
                    <DatePicker SelectedDate="{Binding StartedDate}"
                                Margin="0,2,0,12" />

                    <StackPanel Visibility="{Binding IsPlatinum, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,12">
                        <TextBlock Text="Fecha de platino" Style="{StaticResource MutedText}" />
                        <DatePicker SelectedDate="{Binding PlatinumDate}"
                                    Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Text="Progreso (%)" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding CompletionPercentage}"
                               Margin="0,2,0,12" />

                    <TextBlock Text="XP ganado" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding XpEarned}"
                               Margin="0,2,0,12" />

                    <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,12,16,16">
                <Button Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
