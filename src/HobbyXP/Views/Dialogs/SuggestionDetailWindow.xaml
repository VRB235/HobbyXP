<Window x:Class="HobbyXP.Views.Dialogs.SuggestionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de sugerencia"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Width="640"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Body}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,12,12,8">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="32" Height="32"
                        Padding="0"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Cerrar"
                        Click="OnCloseClick" />
                <TextBlock Text="Detalle de sugerencia"
                           Style="{StaticResource SectionTitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="16,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Título" Style="{StaticResource MutedText}" />
                    <TextBox Text="{Binding Title, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontSize="16"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             Margin="0,2,0,14"
                             ToolTip="Seleccione para copiar" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                            <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding KindLabel}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Estado" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding StatusLabel}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Fecha" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ReportedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat={}{0:dd/MM/yyyy}}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Resuelta" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="ResolvedAtText" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="Copiar"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,2"
                                VerticalAlignment="Center"
                                ToolTip="Copiar descripción al portapapeles"
                                Click="OnCopyDescriptionClick" />
                        <TextBlock Text="Descripción"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Description, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="96"
                             MaxHeight="220"
                             Margin="0,0,0,14"
                             ToolTip="Seleccione texto o use Copiar" />

                    <TextBlock Text="Imágenes" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBlock x:Name="NoPhotosText"
                               Text="Sin imágenes adjuntas."
                               Style="{StaticResource MutedText}"
                               Visibility="Collapsed"
                               Margin="0,0,0,4" />
                    <ItemsControl x:Name="PhotosList"
                                  ItemsSource="{Binding PhotoPath, Converter={StaticResource PhotoPathsToImagesConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="96" Height="96" Margin="0,0,8,8" Padding="0"
                                        Cursor="Hand"
                                        ToolTip="Clic para ampliar"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Click="OnPhotoClick"
                                        Tag="{Binding FilePath}">
                                    <Border Width="94" Height="94" CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,12,16,16">
                <Button Content="Cerrar"
                        Style="{StaticResource AccentButton}"
                        MinWidth="96"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
