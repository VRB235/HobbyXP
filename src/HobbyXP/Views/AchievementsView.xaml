<UserControl x:Class="HobbyXP.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbyXP.Helpers"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Logros y Premios" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Vitrina">
                <ScrollViewer DataContext="{Binding Medals}">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Margin="0,0,0,10">
                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ProgressText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontWeight="Normal"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>
                                    <ItemsControl ItemsSource="{Binding Medals}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="6" Padding="14" Height="220" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{StaticResource BgCardBrush}"
                                                        ToolTip="{Binding UnlockHint}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarned}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEarned}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                                                                    <Setter Property="Background" Value="#2A2418" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   Style="{StaticResource CardTitleText}"
                                                                   TextAlignment="Center" />

                                                        <Grid Grid.Row="1" Margin="0,8,0,8">
                                                            <Image Source="{Binding IconPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                   Stretch="Uniform"
                                                                   MaxHeight="88"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />

                                                            <TextBlock Text="{Binding Code, Converter={StaticResource MedalCodeToEmojiConverter}}"
                                                                       FontSize="52"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource InverseNullToVisibilityConverter}}" />

                                                            <TextBlock Text="🔒"
                                                                       FontSize="18"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,-2,2,0"
                                                                       Opacity="0.85"
                                                                       Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,6" />

                                                        <TextBlock Grid.Row="3"
                                                                   Text="{Binding EarnedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=Desbloqueada: {0:dd/MM/yyyy}}"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                                   FontSize="11"
                                                                   Visibility="{Binding IsEarned, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                        <TextBlock Grid.Row="3"
                                                                   Text="Pendiente"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor de medallas">
                <Grid DataContext="{Binding MedalsEditor}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Catálogo" Padding="8" Margin="0,0,8,0">
                        <ListView ItemsSource="{Binding Medals}"
                                  SelectedItem="{Binding SelectedMedal}"
                                  helpers:GridViewStretchHelper.StretchColumns="True"
                                  helpers:GridViewSortHelper.EnableSort="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="160" />
                                    <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Detalle editable" Padding="12">
                        <StackPanel IsEnabled="{Binding HasSelectedMedal}">
                            <TextBlock Text="{Binding SelectedMedalCategory, StringFormat=Evento: {0}}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                            <TextBlock Text="Descripción" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Margin="0,0,0,8" />

                            <TextBlock Text="Pista de desbloqueo (tooltip)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditUnlockHint, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8" />

                            <TextBlock Text="Icono" Style="{StaticResource MutedText}" />
                            <Image Source="{Binding EditIconPath, Converter={StaticResource PathToImageSourceConverter}}"
                                   Width="72" Height="72" Margin="0,4,0,8"
                                   HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditIconPath, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Buscar…" Command="{Binding PickIconCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Content="Restablecer" Command="{Binding ClearIconCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" ToolTip="Vuelve al icono predeterminado del catálogo." />
                            </Grid>

                            <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,8" />
                            <Button Content="Guardar medalla"
                                    Command="{Binding SaveMedalCommand}"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Editor de reglas">
                <Grid DataContext="{Binding Rules}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Reglas de XP" Padding="8" Margin="0,0,8,0">
                        <ListView ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  helpers:GridViewStretchHelper.StretchColumns="True"
                                  helpers:GridViewSortHelper.EnableSort="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding DisplayName}" Width="160" />
                                    <GridViewColumn Header="Pts/unidad" DisplayMemberBinding="{Binding PointsPerUnit}" Width="80" />
                                    <GridViewColumn Header="Activa" DisplayMemberBinding="{Binding IsActive}" Width="60" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Parámetros" Padding="12">
                        <StackPanel IsEnabled="{Binding HasSelectedRule}">
                            <TextBlock Text="{Binding SelectedRuleActionLabel, StringFormat=Acción del sistema: {0}}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedRuleFormulaHint}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nombre en UI" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Unidad" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditUnitLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Puntos por unidad" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditPointsPerUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Bono fijo (opcional)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditFlatBonusPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <CheckBox Content="Regla activa" IsChecked="{Binding EditIsActive}" Margin="0,0,0,8" />

                            <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,8" />
                            <Button Content="Guardar regla"
                                    Command="{Binding SaveRuleCommand}"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Tienda">
                <ScrollViewer x:Name="RewardShopScroll" DataContext="{Binding Rewards}">
                    <StackPanel Margin="8">
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="+ Nuevo premio"
                                    Command="{Binding OpenCreateRewardCommand}"
                                    Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BalanceText}"
                                       Style="{StaticResource SubsectionTitleText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Clic en un premio para ver detalle, editar o canjear."
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,0,0,12" />

                        <GroupBox Header="Disponibles" Padding="12" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding AvailableRewards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="168"
                                                Margin="0,0,12,12"
                                                Background="#152033"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRedeem}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Button Command="{Binding DataContext.OpenRewardDetailCommand, ElementName=RewardShopScroll}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ToolTip="{Binding RedeemStatusToolTip}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="110" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Background="#1A2233"
                                                                CornerRadius="10,10,0,0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="Sin imagen"
                                                                           Style="{StaticResource MutedText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                <Image Source="{Binding ImageDisplayPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <Border CornerRadius="4"
                                                                        Padding="6,2"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Margin="6">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#80443322" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CanRedeem}" Value="True">
                                                                                    <Setter Property="Background" Value="#803A7A5A" />
                                                                                </DataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasModule}" Value="True" />
                                                                                        <Condition Binding="{Binding CanRedeem}" Value="False" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Background" Value="#80553A10" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RedeemStatusLabel}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               MaxWidth="140">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#FFB39A" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanRedeem}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                                                    </DataTrigger>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding HasModule}" Value="True" />
                                                                                            <Condition Binding="{Binding CanRedeem}" Value="False" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="Foreground" Value="#FF9100" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="40"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock Text="{Binding CostLabel}"
                                                                       Style="{StaticResource MutedText}"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding RedeemStatusLabel}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FFB39A" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanRedeem}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding HasModule}" Value="True" />
                                                                                    <Condition Binding="{Binding CanRedeem}" Value="False" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="#FF9100" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <DockPanel Margin="0,4,0,0">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding PriceLabel}"
                                                                           Style="{StaticResource MutedText}" />
                                                                <TextBlock Text="{Binding ModuleLabel}"
                                                                           Style="{StaticResource MutedText}" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Header="Inventario (canjeados)" Padding="12">
                            <ItemsControl ItemsSource="{Binding InventoryRewards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="168"
                                                Margin="0,0,12,12"
                                                Background="#152033"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEquipped}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Button Command="{Binding DataContext.OpenRewardDetailCommand, ElementName=RewardShopScroll}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        ToolTip="Ver o equipar reliquia">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="110" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Background="#1A2233"
                                                                CornerRadius="10,10,0,0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="Sin imagen"
                                                                           Style="{StaticResource MutedText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                <Image Source="{Binding ImageDisplayPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <Border Background="#80000000"
                                                                        CornerRadius="4"
                                                                        Padding="6,2"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Margin="6"
                                                                        Visibility="{Binding IsEquipped, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="Equipado"
                                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="40"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock Text="{Binding CostLabel}"
                                                                       Style="{StaticResource MutedText}"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" />
                                                            <DockPanel Margin="0,4,0,0">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding EquipButtonLabel}"
                                                                           Style="{StaticResource MutedText}" />
                                                                <TextBlock Text="{Binding ModuleLabel}"
                                                                           Style="{StaticResource MutedText}" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
