<UserControl x:Class="HobbyXP.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbyXP.Helpers"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Logros y Premios" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Vitrina">
                <ScrollViewer DataContext="{Binding Medals}">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Margin="0,0,0,10">
                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ProgressText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontWeight="Normal"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>
                                    <ItemsControl ItemsSource="{Binding Medals}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="6" Padding="14" Height="220" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{StaticResource BgCardBrush}"
                                                        ToolTip="{Binding UnlockHint}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEarned}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEarned}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                                                                    <Setter Property="Background" Value="#2A2418" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   Style="{StaticResource CardTitleText}"
                                                                   TextAlignment="Center" />

                                                        <Grid Grid.Row="1" Margin="0,8,0,8">
                                                            <Image Source="{Binding IconPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                   Stretch="Uniform"
                                                                   MaxHeight="88"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />

                                                            <TextBlock Text="{Binding Code, Converter={StaticResource MedalCodeToEmojiConverter}}"
                                                                       FontSize="52"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource InverseNullToVisibilityConverter}}" />

                                                            <TextBlock Text="🔒"
                                                                       FontSize="18"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,-2,2,0"
                                                                       Opacity="0.85"
                                                                       Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,6" />

                                                        <TextBlock Grid.Row="3"
                                                                   Text="{Binding EarnedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=Desbloqueada: {0:dd/MM/yyyy}}"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                                   FontSize="11"
                                                                   Visibility="{Binding IsEarned, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                        <TextBlock Grid.Row="3"
                                                                   Text="Pendiente"
                                                                   TextAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor de medallas">
                <Grid DataContext="{Binding MedalsEditor}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Catálogo" Padding="8" Margin="0,0,8,0">
                        <ListView ItemsSource="{Binding Medals}"
                                  SelectedItem="{Binding SelectedMedal}"
                                  helpers:GridViewStretchHelper.StretchColumns="True"
                                  helpers:GridViewSortHelper.EnableSort="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="160" />
                                    <GridViewColumn Header="Código" DisplayMemberBinding="{Binding Code}" Width="120" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Detalle editable" Padding="12">
                        <StackPanel IsEnabled="{Binding HasSelectedMedal}">
                            <TextBlock Text="{Binding SelectedMedalCategory, StringFormat=Evento: {0}}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                            <TextBlock Text="Descripción" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Margin="0,0,0,8" />

                            <TextBlock Text="Pista de desbloqueo (tooltip)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditUnlockHint, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8" />

                            <TextBlock Text="Icono" Style="{StaticResource MutedText}" />
                            <Image Source="{Binding EditIconPath, Converter={StaticResource PathToImageSourceConverter}}"
                                   Width="72" Height="72" Margin="0,4,0,8"
                                   HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditIconPath, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Buscar…" Command="{Binding PickIconCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Content="Restablecer" Command="{Binding ClearIconCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" ToolTip="Vuelve al icono predeterminado del catálogo." />
                            </Grid>

                            <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,8" />
                            <Button Content="Guardar medalla"
                                    Command="{Binding SaveMedalCommand}"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Editor de reglas">
                <Grid DataContext="{Binding Rules}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Reglas de XP" Padding="8" Margin="0,0,8,0">
                        <ListView ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  helpers:GridViewStretchHelper.StretchColumns="True"
                                  helpers:GridViewSortHelper.EnableSort="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding DisplayName}" Width="160" />
                                    <GridViewColumn Header="Pts/unidad" DisplayMemberBinding="{Binding PointsPerUnit}" Width="80" />
                                    <GridViewColumn Header="Activa" DisplayMemberBinding="{Binding IsActive}" Width="60" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Parámetros" Padding="12">
                        <StackPanel IsEnabled="{Binding HasSelectedRule}">
                            <TextBlock Text="{Binding SelectedRuleActionLabel, StringFormat=Acción del sistema: {0}}"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedRuleFormulaHint}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nombre en UI" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Unidad" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditUnitLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Puntos por unidad" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditPointsPerUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="Bono fijo (opcional)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding EditFlatBonusPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <CheckBox Content="Regla activa" IsChecked="{Binding EditIsActive}" Margin="0,0,0,8" />

                            <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,8" />
                            <Button Content="Guardar regla"
                                    Command="{Binding SaveRuleCommand}"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Tienda">
                <ScrollViewer x:Name="RewardShopScroll" DataContext="{Binding Rewards}">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding BalanceText}" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,12" />

                        <GroupBox Header="{Binding FormTitle}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Módulo" Style="{StaticResource MutedText}" />
                                        <ComboBox ItemsSource="{Binding ModuleOptions}"
                                                  SelectedItem="{Binding SelectedModule}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding Name}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Costo base (XP)" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding CostInPoints}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="Precio ($)" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding PriceText}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Descripción (opcional)" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding Description}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Link de compra" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding PurchaseUrl}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Abrir link"
                                            Command="{Binding OpenPurchaseUrlCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Margin="0,16,8,0"
                                            VerticalAlignment="Top" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,16,0,0">
                                        <Border Width="56" Height="56" CornerRadius="6" ClipToBounds="True"
                                                Background="#1A2233" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" Margin="0,0,8,0"
                                                Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Command="{Binding OpenPhotoCommand}"
                                                    CommandParameter="{Binding PreviewImagePath}"
                                                    ToolTip="Clic para ampliar · Abrir en el sistema desde el visor"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0">
                                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                                       Stretch="UniformToFill"
                                                       Width="56" Height="56" />
                                            </Button>
                                        </Border>
                                        <Button Content="Ver" Command="{Binding OpenPhotoCommand}"
                                                CommandParameter="{Binding PreviewImagePath}"
                                                Style="{StaticResource AccentButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Imagen" Command="{Binding PickImageCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <Button Content="Quitar" Command="{Binding ClearImageCommand}"
                                                Style="{StaticResource AccentButton}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="{Binding PrimaryActionLabel}"
                                            Command="{Binding CreateRewardCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <Button Content="{Binding PrimaryActionLabel}"
                                            Command="{Binding SaveRewardCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="Nuevo" Command="{Binding ClearFormCommand}"
                                            Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                                    <Button Content="Asignar módulo" Command="{Binding AssignModuleCommand}"
                                            Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                                    <Button Content="Eliminar" Command="{Binding DeleteRewardCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <TextBlock Text="Al canjear se cobra base × nivel global actual. Seleccione un premio para editar nombre, precio, link, imagen y módulo."
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Disponibles" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding AvailableSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding}"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Margin="0,0,0,8">
                                                <Expander.HeaderTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding ProgressText}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontWeight="Normal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="16,0,0,0" />
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </Expander.HeaderTemplate>
                                                <ListView ItemsSource="{Binding Rewards}"
                                                          SelectedItem="{Binding DataContext.SelectedAvailable, ElementName=RewardShopScroll}"
                                                          MinHeight="48"
                                                          MaxHeight="180"
                                                          Margin="0,4,0,0"
                                                          helpers:GridViewStretchHelper.StretchColumns="True"
                                                          helpers:GridViewSortHelper.EnableSort="True">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="" Width="44">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.OpenPhotoCommand, ElementName=RewardShopScroll}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Ver imagen"
                                                                                Cursor="Hand"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="0"
                                                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Image Width="28" Height="28"
                                                                                   Source="{Binding ImageDisplayPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                                   Stretch="UniformToFill" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="160" />
                                                            <GridViewColumn Header="Costo efectivo" DisplayMemberBinding="{Binding CostLabel}" Width="200" />
                                                            <GridViewColumn Header="Precio" DisplayMemberBinding="{Binding PriceLabel}" Width="80" />
                                                            <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding StatusLabel}" Width="90" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedRewardRedeemHint}" Margin="0,0,0,8" />
                                <Button Content="Canjear" Command="{Binding RedeemRewardCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButton}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Inventario (canjeados)" Padding="12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding InventorySections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding}"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Margin="0,0,0,8">
                                                <Expander.HeaderTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding ProgressText}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontWeight="Normal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="16,0,0,0" />
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </Expander.HeaderTemplate>
                                                <ListView ItemsSource="{Binding Rewards}"
                                                          SelectedItem="{Binding DataContext.SelectedInventory, ElementName=RewardShopScroll}"
                                                          MinHeight="48"
                                                          MaxHeight="180"
                                                          Margin="0,4,0,0"
                                                          helpers:GridViewStretchHelper.StretchColumns="True"
                                                          helpers:GridViewSortHelper.EnableSort="True">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="" Width="44">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.OpenPhotoCommand, ElementName=RewardShopScroll}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Ver imagen"
                                                                                Cursor="Hand"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="0"
                                                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Image Width="28" Height="28"
                                                                                   Source="{Binding ImageDisplayPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                                                   Stretch="UniformToFill" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="160" />
                                                            <GridViewColumn Header="Canje" DisplayMemberBinding="{Binding CostLabel}" Width="150" />
                                                            <GridViewColumn Header="Precio" DisplayMemberBinding="{Binding PriceLabel}" Width="80" />
                                                            <GridViewColumn Header="Equipo" DisplayMemberBinding="{Binding EquipButtonLabel}" Width="90" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Equipar reliquia" Command="{Binding EquipRewardCommand}"
                                            Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                                    <Button Content="Desequipar" Command="{Binding UnequipRewardCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
