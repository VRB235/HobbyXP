<UserControl x:Class="HobbyXP.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Logros y Premios" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Vitrina">
                <ScrollViewer DataContext="{Binding Medals}">
                    <ItemsControl ItemsSource="{Binding Medals}" Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="14" Height="220" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Background="{StaticResource BgCardBrush}"
                                        ToolTip="{Binding UnlockHint}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEarned}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEarned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                                                    <Setter Property="Background" Value="#2A2418" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource CardTitleText}"
                                                   TextAlignment="Center" />

                                        <Grid Grid.Row="1" Margin="0,8,0,8">
                                            <Image Source="{Binding IconPath, Converter={StaticResource PathToImageSourceConverter}}"
                                                   Stretch="Uniform"
                                                   MaxHeight="88"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding Code, Converter={StaticResource MedalCodeToEmojiConverter}}"
                                                       FontSize="52"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconPath, Converter={StaticResource InverseNullToVisibilityConverter}}" />

                                            <TextBlock Text="🔒"
                                                       FontSize="18"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="0,-2,2,0"
                                                       Opacity="0.85"
                                                       Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </Grid>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding EarnedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=Desbloqueada: {0:dd/MM/yyyy}}"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding IsEarned, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Grid.Row="3"
                                                   Text="Pendiente"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding IsEarned, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor de reglas">
                <Grid DataContext="{Binding Rules}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="DisplayName" Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Nombre" />
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="Unidad" />
                        <TextBox Text="{Binding EditUnitLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="Puntos por unidad" />
                        <TextBox Text="{Binding EditPointsPerUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="Bono fijo" />
                        <TextBox Text="{Binding EditFlatBonusPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <CheckBox Content="Activa" IsChecked="{Binding EditIsActive}" Margin="0,0,0,8" />
                        <controls:FormValidationBanner Message="{Binding ValidationMessage}" Margin="0,0,0,12" />
                        <Button Content="Guardar regla"
                                Command="{Binding SaveRuleCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Tienda">
                <ScrollViewer DataContext="{Binding Rewards}">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding BalanceText}" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,12" />

                        <GroupBox Header="Crear premio" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding Name}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Costo (XP)" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding CostInPoints}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Descripción (opcional)" Style="{StaticResource MutedText}" />
                                        <TextBox Text="{Binding Description}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="Crear" Command="{Binding CreateRewardCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                                </Grid>
                                <controls:FormValidationBanner Message="{Binding ValidationMessage}" />
                            </StackPanel>
                        </GroupBox>

                        <ListBox ItemsSource="{Binding Rewards}" SelectedItem="{Binding SelectedReward}" Height="220" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="200" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CostInPoints, StringFormat={}{0} XP}" Width="80" />
                                        <TextBlock Text="{Binding StatusLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding SelectedRewardRedeemHint}" Margin="0,0,0,8" />
                        <Button Content="Canjear" Command="{Binding RedeemRewardCommand}" HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAffordSelected}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
