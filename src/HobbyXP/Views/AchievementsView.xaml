<UserControl x:Class="HobbyXP.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Logros y Premios" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Vitrina">
                <ScrollViewer DataContext="{Binding Medals}">
                    <ItemsControl ItemsSource="{Binding Medals}" Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Background="{StaticResource BgCardBrush}"
                                        ToolTip="{Binding UnlockHint}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEarned}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEarned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGoldBrush}" />
                                                    <Setter Property="Background" Value="#2A2418" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor de reglas">
                <Grid DataContext="{Binding Rules}" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="DisplayName" Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel DataContext="{Binding SelectedRule}">
                            <TextBlock Text="Nombre" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyLostFocus}" Margin="0,0,0,8" />
                            <TextBlock Text="Unidad" />
                            <TextBox Text="{Binding UnitLabel, UpdateSourceTrigger=PropertyLostFocus}" Margin="0,0,0,8" />
                            <TextBlock Text="Puntos por unidad" />
                            <TextBox Text="{Binding PointsPerUnit, UpdateSourceTrigger=PropertyLostFocus}" Margin="0,0,0,8" />
                            <TextBlock Text="Bono fijo" />
                            <TextBox Text="{Binding FlatBonusPoints, UpdateSourceTrigger=PropertyLostFocus}" Margin="0,0,0,8" />
                            <CheckBox Content="Activa" IsChecked="{Binding IsActive}" Margin="0,0,0,12" />
                        </StackPanel>
                        <Button Content="Guardar regla"
                                Command="{Binding SaveRuleCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Tienda">
                <ScrollViewer DataContext="{Binding Rewards}">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding BalanceText}" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <GroupBox Header="Crear premio" Padding="12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180" Text="{Binding Name}" Margin="0,0,8,0" />
                                <TextBox Width="100" Text="{Binding CostInPoints}" Margin="0,0,8,0" />
                                <TextBox Width="220" Text="{Binding Description}" Margin="0,0,8,0" />
                                <Button Content="Crear" Command="{Binding CreateRewardCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </GroupBox>

                        <ListBox ItemsSource="{Binding Rewards}" SelectedItem="{Binding SelectedReward}" Height="220" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="200" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CostInPoints, StringFormat={}{0} XP}" Width="80" />
                                        <TextBlock Text="{Binding Status}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding SelectedRewardRedeemHint}" Margin="0,0,0,8" />
                        <Button Content="Canjear" Command="{Binding RedeemRewardCommand}" HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAffordSelected}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
