<UserControl x:Class="HobbyXP.Views.PhysicalActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             xmlns:helpers="clr-namespace:HobbyXP.Helpers"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:FlexibleNumberConverter x:Key="FlexibleNumber" />
    </UserControl.Resources>
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Actividades Físicas" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Stretch">
            <TabItem Header="Running">
                <Grid DataContext="{Binding Running}" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Nueva sesión" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Distancia (km):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding DistanceKm, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="2" Text="Min:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBox Grid.Column="3" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="4" Text="Seg:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBox Grid.Column="5" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="6" Text="Carrera:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <ComboBox Grid.Column="7" ItemsSource="{Binding RaceOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedRaceOption}" />

                                <Button Grid.Column="8" Content="Guardar" Command="{Binding SaveSessionCommand}" Style="{StaticResource AccentButton}" Margin="12,0,0,0" />
                            </Grid>
                        </GroupBox>

                        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,8" />

                        <GroupBox Grid.Row="2" Header="Nueva carrera oficial" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding NewRaceName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Distancia (km)" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding NewRaceDistanceKm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Fecha (opcional)" Style="{StaticResource MutedText}" />
                                    <DatePicker SelectedDate="{Binding NewRaceEventDate}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Ubicación (opcional)" Style="{StaticResource MutedText}" />
                                    <TextBox Text="{Binding NewRaceLocation, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Grid.Column="4" Content="Registrar carrera"
                                        Command="{Binding RegisterOfficialRaceCommand}"
                                        Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="Historial de carreras oficiales" Padding="12" Margin="0,0,0,12" VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0"
                                            DataContext="{Binding SelectedRaceStats}"
                                            Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="Estadísticas de preparación" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding TrainingSessionCount, StringFormat=Entrenamientos: {0}}" />
                                    <TextBlock Text="{Binding TotalTrainingKm, StringFormat=Km totales: {0:0.##}}" />
                                    <TextBlock Text="{Binding BestPaceMinPerKm, StringFormat=Mejor ritmo: {0:0.00} min/km}" />
                                </StackPanel>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Buscar por nombre o ubicación" Style="{StaticResource MutedText}" />
                                            <TextBox Text="{Binding RaceSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding RacesFromDate}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker Grid.Column="4" SelectedDate="{Binding RacesToDate}" Margin="0,0,8,0" />
                                        <Button Grid.Column="5"
                                                Content="Limpiar"
                                                Command="{Binding ClearOfficialRacesFilterCommand}"
                                                Style="{StaticResource PrimaryButton}" />
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                        <Button Content="Marcar completada"
                                                Command="{Binding CompleteRaceCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Eliminar"
                                                Command="{Binding DeleteOfficialRaceCommand}"
                                                Style="{StaticResource DangerIconButton}"
                                                ToolTip="Eliminar carrera del historial"
                                                Padding="12,6" />
                                    </StackPanel>

                                    <ListView Grid.Row="2"
                                              ItemsSource="{Binding OfficialRaces}"
                                              SelectedItem="{Binding SelectedRace}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              helpers:GridViewStretchHelper.StretchColumns="True">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="180" />
                                                <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding EventDateLabel}" Width="90" />
                                                <GridViewColumn Header="Km" DisplayMemberBinding="{Binding DistanceKm, StringFormat={}{0:0.##}}" Width="55" />
                                                <GridViewColumn Header="Ubicación" DisplayMemberBinding="{Binding LocationLabel}" Width="140" />
                                                <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding StatusLabel}" Width="90" />
                                                <GridViewColumn Header="" Width="44">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕"
                                                                    Style="{StaticResource DangerIconButton}"
                                                                    ToolTip="Eliminar del historial"
                                                                    Command="{Binding DataContext.DeleteOfficialRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="4" Header="Sesiones recientes" Padding="12" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding SessionsFromDate}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding SessionsToDate}" Margin="0,0,16,0" />
                                    <Button Grid.Column="4"
                                            Content="Limpiar"
                                            Command="{Binding ClearSessionsDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                </Grid>

                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding Sessions}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          helpers:GridViewStretchHelper.StretchColumns="True">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding RecordedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                                            <GridViewColumn Header="Km" DisplayMemberBinding="{Binding DistanceKm, StringFormat={}{0:0.##}}" Width="50" />
                                            <GridViewColumn Header="Ritmo" DisplayMemberBinding="{Binding PaceMinPerKm, StringFormat={}{0:0.00} min/km}" Width="110" />
                                            <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="50" />
                                            <GridViewColumn Header="Carrera oficial" DisplayMemberBinding="{Binding CarreraOficialNombre}" Width="160" />
                                            <GridViewColumn Header="" Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕"
                                                                Style="{StaticResource DangerIconButton}"
                                                                ToolTip="Eliminar del historial"
                                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Gimnasio">
                <Grid DataContext="{Binding Gym}" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Catálogo de ejercicios" Padding="12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding NewExerciseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <ComboBox Width="160" ItemsSource="{Binding ExerciseTypes}" SelectedItem="{Binding NewExerciseType}" Margin="0,0,8,0" />
                                <Button Content="Agregar ejercicio" Command="{Binding CreateExerciseCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Entrenamiento" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Background="{StaticResource BgCardBrush}">
                                    <StackPanel Grid.IsSharedSizeScope="True">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" SharedSizeGroup="GymExercise" />
                                            <ColumnDefinition Width="*" SharedSizeGroup="GymType" />
                                            <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                            <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                            <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                            <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                            <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GymDelete" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Ejercicio" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="Tipo" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="Series" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="3" Text="Reps" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="4" Text="Peso (kg)" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="5" Text="Min" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="6" Text="Seg" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" SharedSizeGroup="GymExercise" />
                                                        <ColumnDefinition Width="*" SharedSizeGroup="GymType" />
                                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="GymNumeric" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="GymDelete" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.Exercises, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedExerciseId}" Margin="0,0,6,0" />

                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding DataContext.ExerciseTypes, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                              SelectedItem="{Binding ExerciseType}" Margin="0,0,6,0" />

                                                    <controls:NumericStepper Grid.Column="2"
                                                                             Value="{Binding Sets, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                             Minimum="1"
                                                                             Margin="0,0,6,0" />

                                                    <controls:NumericStepper Grid.Column="3"
                                                                             Value="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                             Minimum="1"
                                                                             IsEnabled="{Binding CanEditRepetitions}"
                                                                             Margin="0,0,6,0" />

                                                    <controls:NumericStepper Grid.Column="4"
                                                                             Value="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                             Minimum="0"
                                                                             Step="2.5"
                                                                             DecimalPlaces="1"
                                                                             IsEnabled="{Binding CanEditWeight}"
                                                                             Margin="0,0,6,0" />

                                                    <controls:NumericStepper Grid.Column="5"
                                                                             Value="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                             Minimum="0"
                                                                             IsEnabled="{Binding CanEditDuration}"
                                                                             Margin="0,0,6,0" />

                                                    <controls:NumericStepper Grid.Column="6"
                                                                             Value="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleNumber}}"
                                                                             Minimum="0"
                                                                             Maximum="59"
                                                                             IsEnabled="{Binding CanEditDuration}"
                                                                             Margin="0,0,6,0" />

                                                    <Button Grid.Column="7" Content="✕"
                                                            Style="{StaticResource DangerIconButton}"
                                                            ToolTip="Eliminar fila"
                                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Agregar ejercicio" Command="{Binding AddRowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="Guardar entrenamiento" Command="{Binding SaveWorkoutCommand}" Style="{StaticResource AccentButton}" />
                            </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Historial de entrenamientos" Padding="12" Margin="0,0,0,12" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding HistoryFromDate}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding HistoryToDate}" Margin="0,0,16,0" />
                                    <Button Grid.Column="4"
                                            Content="Limpiar"
                                            Command="{Binding ClearHistoryDateFilterCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                </Grid>

                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding History}"
                                          SelectedItem="{Binding SelectedWorkout}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          helpers:GridViewStretchHelper.StretchColumns="True">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding WorkoutDate, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                                            <GridViewColumn Header="Ejercicios" DisplayMemberBinding="{Binding ExerciseCount}" Width="80" />
                                            <GridViewColumn Header="Resumen" DisplayMemberBinding="{Binding ExerciseSummary}" Width="260" />
                                            <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="50" />
                                            <GridViewColumn Header="Récord" DisplayMemberBinding="{Binding OverloadLabel}" Width="70" />
                                            <GridViewColumn Header="" Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕"
                                                                Style="{StaticResource DangerIconButton}"
                                                                ToolTip="Eliminar del historial"
                                                                Command="{Binding DataContext.DeleteWorkoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <TextBlock Grid.Row="2"
                                           Text="Detalle del entrenamiento seleccionado"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,12,0,6"
                                           Visibility="{Binding SelectedWorkout, Converter={StaticResource NullToVisibility}}" />

                                <ListView Grid.Row="3"
                                          ItemsSource="{Binding SelectedWorkout.Entries}"
                                          MaxHeight="160"
                                          HorizontalAlignment="Stretch"
                                          helpers:GridViewStretchHelper.StretchColumns="True"
                                          Visibility="{Binding SelectedWorkout, Converter={StaticResource NullToVisibility}}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Ejercicio" DisplayMemberBinding="{Binding Exercise.Name}" Width="180" />
                                            <GridViewColumn Header="Detalle" DisplayMemberBinding="{Binding DetailSummary}" Width="200" />
                                            <GridViewColumn Header="Récord personal" DisplayMemberBinding="{Binding RecordLabel}" Width="110" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </GroupBox>

                        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
