<UserControl x:Class="HobbyXP.Views.PhysicalActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HobbyXP.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="Actividades Físicas" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Running">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Running}" Margin="8">
                        <GroupBox Header="Nueva sesión" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Distancia (km):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding DistanceKm, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="2" Text="Min:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBox Grid.Column="3" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="4" Text="Seg:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBox Grid.Column="5" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="6" Text="Carrera:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <ComboBox Grid.Column="7" ItemsSource="{Binding RaceOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedRaceOption}" />

                                <Button Grid.Column="8" Content="Guardar" Command="{Binding SaveSessionCommand}" Style="{StaticResource AccentButton}" Margin="12,0,0,0" />
                            </Grid>
                        </GroupBox>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,8" />

                        <GroupBox Header="Historial de carreras oficiales" Padding="12" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ListBox ItemsSource="{Binding OfficialRaces}" SelectedItem="{Binding SelectedRace}" Width="320" Height="120"
                                             DisplayMemberPath="Name" />
                                    <Button Content="Marcar completada" Command="{Binding CompleteRaceCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                </StackPanel>

                                <StackPanel DataContext="{Binding SelectedRaceStats}"
                                            Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="Estadísticas de preparación" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TrainingSessionCount, StringFormat=Entrenamientos: {0}}" />
                                    <TextBlock Text="{Binding TotalTrainingKm, StringFormat=Km totales: {0:0.##}}" />
                                    <TextBlock Text="{Binding BestPaceMinPerKm, StringFormat=Mejor ritmo: {0:0.00} min/km}" />
                                </StackPanel>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Sesiones recientes" Padding="12">
                            <ListView ItemsSource="{Binding Sessions}" Height="200">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding RecordedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="100" />
                                        <GridViewColumn Header="Km" DisplayMemberBinding="{Binding DistanceKm, StringFormat={}{0:0.##}}" Width="60" />
                                        <GridViewColumn Header="Ritmo" DisplayMemberBinding="{Binding PaceMinPerKm, StringFormat={}{0:0.00} min/km}" Width="120" />
                                        <GridViewColumn Header="XP" DisplayMemberBinding="{Binding XpEarned}" Width="60" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gimnasio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Gym}" Margin="8">
                        <GroupBox Header="Catálogo de ejercicios" Padding="12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding NewExerciseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <ComboBox Width="160" ItemsSource="{Binding ExerciseTypes}" SelectedItem="{Binding NewExerciseType}" Margin="0,0,8,0" />
                                <Button Content="Agregar ejercicio" Command="{Binding CreateExerciseCommand}" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Entrenamiento" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8" Background="{StaticResource BgCardBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.Exercises, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedExerciseId}" Margin="0,0,8,0" />

                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding DataContext.ExerciseTypes, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                              SelectedItem="{Binding ExerciseType}" Margin="0,0,8,0" />

                                                    <TextBox Grid.Column="2" Text="{Binding Sets}" ToolTip="Series" Margin="0,0,4,0" />
                                                    <TextBox Grid.Column="3" Text="{Binding Repetitions}" ToolTip="Reps" IsEnabled="{Binding CanEditRepetitions}" Margin="0,0,4,0" />
                                                    <TextBox Grid.Column="4" Text="{Binding WeightKg}" ToolTip="Peso kg" IsEnabled="{Binding CanEditWeight}" Margin="0,0,4,0" />
                                                    <TextBox Grid.Column="5" Text="{Binding DurationMinutes}" ToolTip="Min" IsEnabled="{Binding CanEditDuration}" Margin="0,0,4,0" />
                                                    <TextBox Grid.Column="6" Text="{Binding DurationSeconds}" ToolTip="Seg" IsEnabled="{Binding CanEditDuration}" Margin="0,0,4,0" />

                                                    <Button Grid.Column="7" Content="✕"
                                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                            CommandParameter="{Binding}" Padding="8,2" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+ Fila" Command="{Binding AddRowCommand}" Margin="0,0,8,0" />
                                    <Button Content="Guardar entrenamiento" Command="{Binding SaveWorkoutCommand}" Style="{StaticResource AccentButton}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
