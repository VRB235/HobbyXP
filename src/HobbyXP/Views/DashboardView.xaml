<UserControl x:Class="HobbyXP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:HobbyXP.Converters"
             xmlns:controls="clr-namespace:HobbyXP.Views.Controls"
             xmlns:nav="clr-namespace:HobbyXP.ViewModels.Navigation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="1200">

            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleText}" Margin="0,0,0,20" />

            <!-- Hero: nivel + barra XP -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="88" Height="88" Margin="0,0,24,0">
                        <Ellipse Fill="#2A3347"
                                 Stroke="{StaticResource AccentGoldBrush}"
                                 StrokeThickness="3" />
                        <Ellipse Margin="4"
                                 Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="🛡" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasCustomAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LevelHeroTitle}" Style="{StaticResource DisplayHeroText}" FontSize="28" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding XpHeroSummary}" Margin="0,4,0,12"
                                   Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="SemiBold" />
                        <controls:XpProgressBar Value="{Binding ProgressPercentage}" Height="18" />
                        <TextBlock Text="{Binding LevelProgressText}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hub de logros y premios -->
            <Border Style="{StaticResource DarkCard}" Margin="0,0,0,16" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Logros y premios" Style="{StaticResource SubsectionTitleText}" />
                        <Button Content="Abrir módulo"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{x:Static nav:NavigationSection.Achievements}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Padding="12,4" FontSize="12" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding AchievementHub.HonorTitle, StringFormat=Título de honor: {0}}"
                               Foreground="{StaticResource AccentGoldBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Visibility="{Binding AchievementHub.HonorTitle, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding AchievementHub.ImmunityText}"
                               Foreground="{StaticResource AccentCyanBrush}"
                               FontSize="12"
                               Margin="0,0,0,12"
                               Visibility="{Binding AchievementHub.IsImmune, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Última medalla" Style="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock Text="{Binding AchievementHub.LatestEarned.Name, FallbackValue=Aún no hay medallas}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding AchievementHub.LatestEarned.Description}"
                                       Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding AchievementHub.HasLatestEarned, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Siguiente logro" Style="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock Text="{Binding AchievementHub.ClosestNext.Name, FallbackValue=Catálogo completado}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource AccentGoldBrush}" />
                            <TextBlock Text="{Binding AchievementHub.ClosestNext.ProgressText}"
                                       Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,4"
                                       Visibility="{Binding AchievementHub.HasClosestNext, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:XpProgressBar Value="{Binding AchievementHub.ClosestNext.Percent}" Height="8"
                                                    Visibility="{Binding AchievementHub.HasClosestNext, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Premio destacado" Style="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock Text="{Binding AchievementHub.FeaturedReward.Name, FallbackValue=Cree un premio en la tienda}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding AchievementHub.FeaturedModuleName}"
                                       Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                                       Visibility="{Binding AchievementHub.HasFeaturedReward, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding AchievementHub.FeaturedCostText}"
                                       Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding AchievementHub.HasFeaturedReward, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="¡Puede canjearlo!"
                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding AchievementHub.CanAffordFeatured, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Disciplina semanal -->
            <Expander Header="Disciplina (diaria + semanal)"
                      IsExpanded="{Binding IsDisciplineExpanded, Mode=TwoWay}"
                      Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Running/Gym/Libros/Cursos: cuota diaria (Cumplida si hoy está al día) y cuota semanal. El castigo diario se aplica al día siguiente si no registró; el semanal al cerrar la semana. Diario: 1 sesión (libros: 20% de páginas). Semanal: Running 4, Gym 5, Curso 5 sesiones, Libro 1 terminado. Otros hobbies solo semanal. Actividad atrasada puede restaurar XP."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WeeklyQuotaItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2233"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubsectionTitleText}" />
                                            <TextBlock Text="{Binding RequirementLabel}" Style="{StaticResource MutedText}" FontSize="12" />
                                            <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0" FontSize="13" />
                                            <TextBlock Text="{Binding ActivePenaltyReminder}"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFB39A"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasActivePenalty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Top"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="En curso" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                    <Style.Triggers>
                                                        <!-- Estado del periodo ABIERTO (hoy / semana actual). Castigos históricos van en el texto naranja, no en el badge. -->
                                                        <DataTrigger Binding="{Binding IsMet}" Value="True">
                                                            <Setter Property="Text" Value="Cumplida" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                                                            <Setter Property="Text" Value="No aplica" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Progreso por hobby -->
            <Expander Header="Progreso por hobby"
                      IsExpanded="{Binding IsHobbyProgressExpanded, Mode=TwoWay}"
                      Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Cada hobby tiene su propio nivel. El nivel global sube al avanzar de nivel en un hobby."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding HobbyProgressItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A2233"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource SubsectionTitleText}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="280">
                                            <Run Text="Nv. " />
                                            <Run Text="{Binding Progress.CurrentLevel}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LevelTitle}" />
                                        </TextBlock>
                                        <controls:XpProgressBar Grid.Row="1"
                                                                Grid.ColumnSpan="2"
                                                                Value="{Binding Progress.ProgressPercentage}"
                                                                Height="10"
                                                                Margin="0,6,0,4" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12">
                                            <Run Text="{Binding Progress.XpIntoCurrentLevel, StringFormat={}{0:N0}}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding Progress.XpRequiredForNextLevel, StringFormat={}{0:N0}}" />
                                            <Run Text=" XP · Total: " />
                                            <Run Text="{Binding Progress.TotalXp, StringFormat={}{0:N0}}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Gráficos -->
            <Expander Header="Estadísticas (XP semanal y distribución)"
                      IsExpanded="{Binding IsChartsExpanded, Mode=TwoWay}"
                      Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Rendimiento semanal" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,4" />
                        <TextBlock Text="XP ganada en los últimos 7 días" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <lvc:CartesianChart Series="{Binding WeeklyXpSeries}"
                                            XAxes="{Binding WeeklyXpXAxes}"
                                            YAxes="{Binding WeeklyXpYAxes}"
                                            Background="Transparent"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"
                                            Height="240" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Distribución de hobbies" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,4" />
                        <TextBlock Text="Registros del mes actual por categoría" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <Grid Height="240">
                            <lvc:PieChart Series="{Binding HobbyDistributionSeries}"
                                          Background="Transparent"
                                          LegendPosition="Bottom"
                                          TooltipPosition="Top"
                                          Visibility="{Binding HasHobbyDistribution, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="Sin registros este mes"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Visibility="{Binding HasHobbyDistribution, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Sugerencias para subir de nivel -->
            <Expander Header="Sugerencias para subir de nivel"
                      IsExpanded="{Binding IsSuggestionsExpanded, Mode=TwoWay}"
                      Margin="0,0,0,12"
                      Visibility="{Binding ShowLevelUpSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding SuggestionsSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SuggestedActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2433" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource SubsectionTitleText}" />
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Mínimo: " />
                                            <Run Text="{Binding MinimumRequirement, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AccentGreenBrush}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding EstimatedXp, Mode=OneWay}" />
                                            <Run Text=" XP)" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Hitos -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Últimos hitos" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                <Button Content="↻ Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="16,0,0,0" Padding="10,6" FontSize="12" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding RecentMilestones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MilestoneCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceType, Converter={StaticResource MilestoneIconConverter}}"
                                               FontSize="32" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold">
                                        <Run Text="+" /><Run Text="{Binding PointsEarned, Mode=OneWay}" /><Run Text=" XP" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
