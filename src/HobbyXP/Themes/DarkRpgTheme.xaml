<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tipografías embebidas -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="Font.BodySemiBold">pack://application:,,,/Assets/Fonts/#Rajdhani SemiBold</FontFamily>

    <!-- Paleta oscura RPG (referencia mockups) -->
    <Color x:Key="Color.BgDeep">#0D1117</Color>
    <Color x:Key="Color.BgMain">#12151C</Color>
    <Color x:Key="Color.BgSidebar">#151B26</Color>
    <Color x:Key="Color.BgCard">#1A2030</Color>
    <Color x:Key="Color.BgCardHover">#222A3C</Color>
    <Color x:Key="Color.BgInput">#1E2433</Color>
    <Color x:Key="Color.Border">#2A3347</Color>
    <Color x:Key="Color.BorderGlow">#334155</Color>
    <Color x:Key="Color.TextPrimary">#F0F4FA</Color>
    <Color x:Key="Color.TextSecondary">#8892A4</Color>
    <Color x:Key="Color.TextMuted">#5C667A</Color>
    <Color x:Key="Color.AccentGreen">#00E676</Color>
    <Color x:Key="Color.AccentCyan">#00E5FF</Color>
    <Color x:Key="Color.AccentPurple">#7C4DFF</Color>
    <Color x:Key="Color.AccentGold">#FFD54F</Color>
    <Color x:Key="Color.AccentOrange">#FF9100</Color>
    <Color x:Key="Color.Danger">#FF5252</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource Color.BgDeep}" />
    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource Color.BgMain}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource Color.BgSidebar}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource Color.BgCard}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource Color.BgCardHover}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource Color.BgInput}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource Color.AccentGreen}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource Color.AccentCyan}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource Color.AccentPurple}" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource Color.AccentGold}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />

    <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D1117" Offset="0" />
        <GradientStop Color="#151B26" Offset="0.55" />
        <GradientStop Color="#101620" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="XpProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C4DFF" Offset="0" />
        <GradientStop Color="#00B0FF" Offset="0.5" />
        <GradientStop Color="#00E676" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2030" Offset="0" />
        <GradientStop Color="#222A3C" Offset="1" />
    </LinearGradientBrush>

    <Pen x:Key="GridLinePen" Brush="#14FFFFFF" Thickness="0.6" />

    <DrawingBrush x:Key="GeometricPatternBrush" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,48,48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Pen="{StaticResource GridLinePen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="48,0" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Pen="{StaticResource GridLinePen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="0,48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0800E676">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="24,24" RadiusX="1.2" RadiusY="1.2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Tipografía -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.BodySemiBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="DisplayHeroText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Tarjeta oscura -->
    <Style x:Key="DarkCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource DarkCard}">
        <Setter Property="Background" Value="{StaticResource HeroCardGradientBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="MilestoneCard" TargetType="Border" BasedOn="{StaticResource DarkCard}">
        <Setter Property="Width" Value="220" />
        <Setter Property="MinHeight" Value="140" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Barra XP estilo RPG (plantilla WPF por defecto; evita fallos de RangeBase.Value) -->
    <Style x:Key="RpgProgressBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="#2A3347" />
        <Setter Property="Foreground" Value="{StaticResource XpProgressFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Botones -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#2A3347" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#354058" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2433" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#1B3D2F" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#234D3A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                Background="{StaticResource AccentGreenBrush}" CornerRadius="2"
                                Visibility="Collapsed" Margin="-12,4,0,4" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2433" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="Background" Value="#1E2433" />
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs oscuros -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
